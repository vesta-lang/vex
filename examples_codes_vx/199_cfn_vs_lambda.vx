namespace ejemplos.cfn_vs_lambda;

// ============================================================================
// METODO  vs  PUNTERO A FUNCION CRUDO (cfn)  vs  LAMBDA (fn)
// ============================================================================
//
// En  hay TRES conceptos relacionados pero DISTINTOS, con representacion,
// coste y semantica diferentes.  Elegir el adecuado es clave para escribir
// codigo eficiente (sobre todo en structs/clases y en bare-metal / FFI).
//
//     lambda (fn)   !=   puntero a funcion (cfn)   !=   metodo
//
// ----------------------------------------------------------------------------
// 1. METODO de struct/clase  --  "miembro funcion"
// ----------------------------------------------------------------------------
//   - El codigo va ASOCIADO AL TIPO, no a la instancia.  NO ocupa espacio en
//     cada objeto (no es un campo).
//   - Dispatch DIRECTO: el compilador sabe en compile-time que funcion llamar;
//     emite un CALL directo y puede INLINEARLO.  Coste minimo.
//   - Fijo: no se puede "reasignar" el metodo de una instancia en runtime.
//   - Un metodo de struct se desugara a una funcion libre que toma `Struct*`
//     como primer argumento.
//
// ----------------------------------------------------------------------------
// 2. cfn(args) -> R  --  "puntero a funcion crudo estilo C"
// ----------------------------------------------------------------------------
//   - Un VALOR de 8 bytes: SOLO la direccion de una funcion.  Como `R(*)(args)`
//     en C.  Sin entorno (env).
//   - Llamada INDIRECTA (CALLIND): la funcion se decide en runtime.
//   - Reasignable; se mete en TABLAS, se pasa a callbacks/FFI, se guarda como
//     CAMPO de un struct/clase (8 bytes).  Es lo que necesita un kernel/driver.
//   - Se obtiene con `&funcion` o con el cast `(cfn(args)->R) direccion`.
//   - Se puede castear entre firmas distintas (la firma es solo compile-time).
//   - `(u64) cfn` / `(i64) &funcion` = la direccion tal cual (8 bytes).
//
// ----------------------------------------------------------------------------
// 3. fn(args) -> R  --  "lambda / closure"
// ----------------------------------------------------------------------------
//   - Un fat-pointer de 16 bytes `{fn_addr, env}` (128 bits): ademas de la
//     direccion, CAPTURA variables del entorno (estado).  Para funciones
//     anonimas con estado.
//   - Llamada por CALLCLOSURE (pasa el env en R14).  Mas pesado que un cfn.
//   - Su caso natural es una VARIABLE local: el slot del env vive en el stack.
//   - REGLA: un lambda son 16 bytes, NO cabe en un entero de 8 -> `(i64)(fn)f`
//     es ERROR.  Para la direccion cruda usa `cfn`/`&`; para deconstruir el
//     {fn_addr, env} castea a un struct de dos i64 (16 == 16).
// ============================================================================

// Funcion nativa via FFI: su direccion (`&toupper`) tambien es un cfn -- el
// compilador genera un thunk Vesta `__cfnthunk_toupper` que reenvia al CALLN,
// asi el cfn se invoca por CALLIND en cualquier backend (la direccion nativa
// no es bytecode VM y no se puede llamar directamente por callvmr).
extern "msvcrt.dll" { fn toupper(i32 c) -> i32; }

// Funciones libres normales (su direccion es un puntero a funcion crudo).
i64 doblar(i64 x) { return x * 2; }
i64 triplicar(i64 x) { return x * 3; }
i64 negar(i64 x) { return 0 - x; }

// callback: recibe un cfn y lo aplica.  El cfn se decide en el call site.
i64 aplicar(cfn(i64) -> i64 f, i64 x) { return f(x); }

// callback recibido por BORROW (prestamo): el cfn lo posee un unique<> del
// caller; aqui solo lo leemos sin tomar ownership.
i64 aplicar_borrow(borrow < cfn(i64) -> i64 > b, i64 x) {
	cfn(i64) -> i64 f = read_borrow(b); // recupera el cfn (8 bytes) del prestamo
	return f(x);
}

// Para DECONSTRUIR un lambda: un struct de dos campos de 64 bits = 16 bytes,
// el mismo layout que el slot {fn_addr, env}.
struct LambdaRaw {
	i64 fn_addr;
	i64 env;
}

// --- 1. METODO: el codigo va con el TIPO (dispatch directo, inline-able) -----
struct Calculadora {
	i64 base;
	// Miembro funcion (metodo).  No ocupa bytes en la instancia; el lowering
	// emite CALL directo a Calculadora_sumar(Calculadora*, i64) -- inline-able.
	i64 sumar(i64 x) { return this.base + x; }
}

// --- 2. cfn FIELD: ATRIBUTO puntero a funcion crudo (8 bytes, CALLIND) -------
struct Operacion {
	i64 valor;
	cfn(i64) -> i64 op; // puntero a funcion estilo C; reasignable en runtime
}

i32 main() {
	// === 1. METODO -- dispatch DIRECTO (inline-able) ===
	Calculadora c;
	c.base = 100;
	i64 r1 = c.sumar(5); // CALL directo -> 100 + 5 = 105
	if (r1 != 105) { return 1; }

	// === 2a. cfn FIELD -- puntero a funcion: indirecto y REASIGNABLE ===
	Operacion o;
	o.valor = 10;
	o.op    = &doblar;        // guarda la DIRECCION de doblar (8 B)
	i64 r2 = (o.op)(o.valor); // CALLIND -> doblar(10) = 20
	if (r2 != 20) { return 2; }

	o.op = triplicar; // NOMBRE DESNUDO (sin &): se promociona
	// a &triplicar automaticamente
	i64 r3 = (o.op)(o.valor); // CALLIND -> triplicar(10) = 30
	if (r3 != 30) { return 3; }

	// === 2b. cfn por CAST de una direccion cruda (tablas, FFI, kernel) ===
	cfn(i64) -> i64 g = (cfn(i64) -> i64)((u64)&doblar);
	if (g(21) != 42) { return 4; } // CALLIND -> doblar(21) = 42

	// === 2c. cfn como PARAMETRO (callback) ===
	if (aplicar(&triplicar, 14) != 42) { return 5; } // triplicar(14) = 42

	// === 2d. TABLA de punteros a funcion (dispatch por indice) ===
	// La tabla guarda las DIRECCIONES como u64 (igual que una api-table de C o
	// de un kernel); cada entrada se castea a cfn al invocarla.
	u64[3] tabla;
	tabla[0] = (u64)&doblar;
	tabla[1] = (u64)&triplicar;
	tabla[2] = (u64)&negar;
	i64 suma = 0_i64;
	for (i64 i = 0_i64; i < 3; i = i + 1) {
		suma = suma + ((cfn(i64) -> i64) tabla[i])(10); // doblar+triplicar+negar
	}
	if (suma != 20 + 30 - 10) { return 6; } // 20 + 30 - 10 = 40

	// === 2e. CAST entre firmas distintas (la firma es solo compile-time) ===
	cfn(i64) -> i64 ci = &doblar;
	cfn(u64) -> u64 cu = (cfn(u64) -> u64) ci;
	if (cu(21) != 42) { return 7; }

	// === 2h. &Tipo.metodo -- puntero a metodo NO LIGADO (estilo C) ===
	// La direccion de un metodo es la de su funcion libre `Tipo__metodo`, que
	// toma el receptor como PRIMER parametro explicito (`Calculadora*` para un
	// struct value-type; la referencia para una clase).  El cfn resultante NO
	// lleva el objeto: hay que pasarlo en cada llamada.
	cfn(Calculadora *, i64) -> i64 pm = &Calculadora.sumar;
	Calculadora                    c2;
	c2.base = 37;
	if (pm(&c2, 5) != 42) { return 13; } // sumar(c2, 5) = 37 + 5 = 42

	// === 2g. INLINE del callback CONOCIDO -- optimizacion ===
	// Cuando el cfn es una constante conocida en compile-time, el optimizador
	// reescribe la llamada indirecta (CALLIND) a un CALL directo a `doblar`,
	// y el inliner puede ABSORBER su cuerpo (aqui, `(21)*2` se pliega a 42 en
	// compile-time -- cero llamada en runtime).
	cfn(i64) -> i64 conocido = &doblar;
	if (conocido(21) != 42) { return 12; } // inline + const-fold -> 42

	// === 2i. &extern -- FFI nativo como cfn (via thunk automatico) ===
	cfn(i32) -> i32 mayus = &toupper;   // genera __cfnthunk_toupper
	if (mayus(97) != 65) { return 14; } // toupper('a') = 'A' = 65

	// === 2f. cfn dentro de unique<> -- ownership + move + borrow ===
	// Un cfn es un valor de 8 bytes, asi que entra en un unique<>/borrow<>
	// como cualquier primitivo (NO se construye un slot de lambda).
	cfn(i64) -> i64            cc     = &doblar;
	unique < cfn(i64) -> i64 > up     = unique_box(cc); // toma posesion (8 B en heap)
	unique < cfn(i64) -> i64 > uq     = move(up);          // transfiere ownership
	cfn(i64) -> i64            desbox = *ptr_of(uq);       // recupera el cfn (1 LOAD)
	if (desbox(21) != 42) { return 10; }                   // doblar(21) = 42
	if (aplicar_borrow(lend(uq), 21) != 42) { return 11; } // prestamo -> 42

	// === 3. LAMBDA -- closure con ENV (16 bytes), captura del entorno ===
	i64            factor  = 7_i64;
	fn(i64) -> i64 escalar = (x) => x * factor; // CAPTURA `factor` (env != 0)
	i64            r8      = escalar(6);        // CALLCLOSURE (env = {factor}) -> 42
	if (r8 != 42) { return 8; }

	// Reasignar el lambda a otra captura (sigue siendo 16 bytes con su env):
	i64 delta = 40_i64;
	escalar = (x) => x + delta;         // nuevo env = {delta}
	if (escalar(2) != 42) { return 9; } // 2 + 40 = 42

	// NOTA: `(i64) escalar` seria ERROR -- un lambda son 16 bytes.  Para la
	// direccion cruda se usa cfn/&; para deconstruirlo, un struct de 16 bytes.

	// Todo OK.  Devolvemos 42.
	return 42;
}
