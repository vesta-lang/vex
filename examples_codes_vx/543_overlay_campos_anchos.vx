namespace ejemplos.overlay_campos_anchos;

// -----------------------------------------------------------------------------
// Vistas: campos CONTIGUOS tratados de una vez (palabras anchas / lanes)
// -----------------------------------------------------------------------------
// Una vista describe una region de bytes campo a campo, pero el codigo que la
// usa casi nunca toca UN campo suelto: pone a cero un bloque entero, lo copia
// de un sitio a otro o lo compara.  Y esos campos, por construccion, estan
// PEGADOS: la vista dice exactamente donde empieza cada uno y cuanto mide.
//
// Ese es justo el permiso que hace falta para tratarlos con palabras mas
// anchas que el campo: si se sabe que `r0` esta en 0x18, mide 8 y `r1` empieza
// en 0x20, entonces los dos juntos son 16 bytes seguidos, y ponerlos a cero es
// UNA escritura de 16 bytes en vez de dos de 8.  El conocimiento de la vista
// (donde esta cada campo, y que ninguno pisa a otro) es lo que lo autoriza.
//
// El caso de abajo es el bloque de contexto de un cambio de tarea, que es donde
// este patron aparece de verdad: 19 campos contiguos, 152 bytes.  Guardarlo,
// restaurarlo y compararlo son las tres operaciones de siempre.

// Bloque de contexto: contador de programa, punteros de pila y el banco entero.
// Es el mismo reparto que usa `swapctx` en el bytecode de la maquina.
@overlay
struct Context {
	u64 pc  @0x00;
	u64 sp  @0x08;
	u64 bp  @0x10;
	u64 r0  @0x18;
	u64 r1  @0x20;
	u64 r2  @0x28;
	u64 r3  @0x30;
	u64 r4  @0x38;
	u64 r5  @0x40;
	u64 r6  @0x48;
	u64 r7  @0x50;
	u64 r8  @0x58;
	u64 r9  @0x60;
	u64 r10 @0x68;
	u64 r11 @0x70;
	u64 r12 @0x78;
	u64 r13 @0x80;
	u64 r14 @0x88;
	u64 r15 @0x90;
}

// (1) PONER A CERO un bloque entero.  Diecinueve campos seguidos, todos con el
// mismo valor: es una sola region de 152 bytes puesta a cero.
void context_clear(Context c) {
	c.pc  = 0_u64;
	c.sp  = 0_u64;
	c.bp  = 0_u64;
	c.r0  = 0_u64;
	c.r1  = 0_u64;
	c.r2  = 0_u64;
	c.r3  = 0_u64;
	c.r4  = 0_u64;
	c.r5  = 0_u64;
	c.r6  = 0_u64;
	c.r7  = 0_u64;
	c.r8  = 0_u64;
	c.r9  = 0_u64;
	c.r10 = 0_u64;
	c.r11 = 0_u64;
	c.r12 = 0_u64;
	c.r13 = 0_u64;
	c.r14 = 0_u64;
	c.r15 = 0_u64;
}

// (2) COPIAR un bloque a otro.  Cada campo se lee de un sitio y se escribe en
// el mismo desplazamiento del otro: la region entera viaja igual.
void context_copy(Context dst, Context src) {
	dst.pc  = src.pc;
	dst.sp  = src.sp;
	dst.bp  = src.bp;
	dst.r0  = src.r0;
	dst.r1  = src.r1;
	dst.r2  = src.r2;
	dst.r3  = src.r3;
	dst.r4  = src.r4;
	dst.r5  = src.r5;
	dst.r6  = src.r6;
	dst.r7  = src.r7;
	dst.r8  = src.r8;
	dst.r9  = src.r9;
	dst.r10 = src.r10;
	dst.r11 = src.r11;
	dst.r12 = src.r12;
	dst.r13 = src.r13;
	dst.r14 = src.r14;
	dst.r15 = src.r15;
}

// (3) COMPARAR dos bloques.  El resultado no depende de en que campo esta cada
// byte, solo de que los 152 sean iguales.
bool context_equals(Context a, Context b) {
	if (a.pc != b.pc) {
		return false;
	}
	if (a.sp != b.sp) {
		return false;
	}
	if (a.bp != b.bp) {
		return false;
	}
	if (a.r0 != b.r0) {
		return false;
	}
	if (a.r1 != b.r1) {
		return false;
	}
	if (a.r2 != b.r2) {
		return false;
	}
	if (a.r3 != b.r3) {
		return false;
	}
	if (a.r4 != b.r4) {
		return false;
	}
	if (a.r5 != b.r5) {
		return false;
	}
	if (a.r6 != b.r6) {
		return false;
	}
	if (a.r7 != b.r7) {
		return false;
	}
	if (a.r8 != b.r8) {
		return false;
	}
	if (a.r9 != b.r9) {
		return false;
	}
	if (a.r10 != b.r10) {
		return false;
	}
	if (a.r11 != b.r11) {
		return false;
	}
	if (a.r12 != b.r12) {
		return false;
	}
	if (a.r13 != b.r13) {
		return false;
	}
	if (a.r14 != b.r14) {
		return false;
	}
	if (a.r15 != b.r15) {
		return false;
	}
	return true;
}

// (4) SUMAR el banco entero.  Los dieciseis sumandos son contiguos, asi que la
// suma se puede llevar por lanes y reducir al final.
u64 bank_sum(Context c) {
	return c.r0 + c.r1 + c.r2 + c.r3 + c.r4 + c.r5 + c.r6 + c.r7 + c.r8 +
		c.r9 + c.r10 + c.r11 + c.r12 + c.r13 + c.r14 + c.r15;
}

// Un registro CORTO, del tamano al que llega una sola escritura ancha.  Es el
// caso de casi cualquier cabecera: la de seccion de un PE mide 40 bytes, la de
// un elemento de una tabla, menos.
@overlay
struct Slot {
	u64 key   @0x00;
	u64 value @0x08;
	u64 next  @0x10;
	u64 flags @0x18;
}

// (5) Poner a cero un registro corto.  Aqui NO compensa el bucle de bloque de
// la maquina: su arranque cuesta mas que la escritura entera.  Treinta y dos
// bytes caben en una lane donde el objetivo las tenga de ese ancho, y en dos
// donde solo llegue a la mitad; el codigo es el mismo y quien elige es el banco.
void slot_clear(Slot s) {
	s.key   = 0_u64;
	s.value = 0_u64;
	s.next  = 0_u64;
	s.flags = 0_u64;
}

i32 main() {
	// Dos bloques de 152 bytes en memoria del anfitrion.
	u8* mem_a = (u8*)malloc(152);
	u8* mem_b = (u8*)malloc(152);

	Context a = Context(mem_a);
	Context b = Context(mem_b);

	// Sin poner a cero, lo que hay en `mem_a` es lo que dejara el asignador.
	context_clear(a);
	context_clear(b);
	println("cero: bank_sum=${bank_sum(a)} iguales=${context_equals(a, b)}");

	// Un contexto con valores: r0..r15 = 1..16.
	a.pc  = 0x1000_u64;
	a.sp  = 0x2000_u64;
	a.bp  = 0x3000_u64;
	a.r0  = 1_u64;
	a.r1  = 2_u64;
	a.r2  = 3_u64;
	a.r3  = 4_u64;
	a.r4  = 5_u64;
	a.r5  = 6_u64;
	a.r6  = 7_u64;
	a.r7  = 8_u64;
	a.r8  = 9_u64;
	a.r9  = 10_u64;
	a.r10 = 11_u64;
	a.r11 = 12_u64;
	a.r12 = 13_u64;
	a.r13 = 14_u64;
	a.r14 = 15_u64;
	a.r15 = 16_u64;

	// 1+2+...+16 = 136.
	println("lleno: bank_sum=${bank_sum(a)} iguales=${context_equals(a, b)}");

	// Guardar y restaurar: tras copiar, los 152 bytes coinciden.
	context_copy(b, a);
	println("copia: bank_sum=${bank_sum(b)} iguales=${context_equals(a, b)}");

	// Un solo campo distinto rompe la igualdad, y la suma no lo nota porque
	// `pc` no esta en el banco: la comparacion mira los 152 bytes, la suma 128.
	b.pc = 0_u64;
	println("difiere: bank_sum=${bank_sum(b)} iguales=${context_equals(a, b)}");

	// El registro corto: se ensucia, se limpia entero y se comprueba.
	u8*  mem_s = (u8*)malloc(32);
	Slot s     = Slot(mem_s);
	s.key   = 7_u64;
	s.value = 8_u64;
	s.next  = 9_u64;
	s.flags = 10_u64;
	slot_clear(s);
	s.value = 3_u64;
	println("corto: suma=${s.key + s.value + s.next + s.flags}");
	free(mem_s);

	free(mem_a);
	free(mem_b);
	return (i32)bank_sum(a); // 136
}
