// AOT thread_local: AISLAMIENTO por-hilo REAL con hilos del SO (Win32).
//
// Este es el punto de thread_local: cada hilo tiene su PROPIA copia.  Se crea
// un hilo nativo con CreateThread cuyo worker pone su `t` a 99 y lo copia a un
// global compartido.  Mientras tanto la copia de `t` del hilo principal sigue
// en 11 -- NO la toca el hilo hijo.  El aislamiento lo garantiza el SO via el
// bloque TLS por-hilo que monta el cargador (PE: IMAGE_TLS_DIRECTORY).
//
// Notar el paso de `worker` (una funcion Vesta) como puntero de funcion a una
// API nativa.  El tipo es `cfn`, el puntero de funcion CRUDO de 8 bytes, que es
// lo que una API del sistema sabe llamar.  Un `fn` es otra cosa -- un lambda de
// 16 bytes: direccion mas entorno --, y castearlo a un entero perderia el
// entorno; el compilador lo rechaza diciendolo.  Aqui hubo un `fn` de cuando
// los dos tipos eran uno solo, y por eso este ejemplo dejo de compilar.
//
// Resultado esperado: main t=11, child t=99 -> 11*1000 + 99 = exit 11099
// (Windows preserva el exit code completo, no lo trunca a 8 bits).

extern "kernel32.dll" {
	fn CreateThread(u64 attr, u64 stack, u64 proc, u64 param,
		u32 flags, u64 idout) -> u64;
	fn WaitForSingleObject(u64 handle, u32 ms) -> u32;
}

thread_local i64 t       = 11_i64; // copia por-hilo
i64              g_child = 0_i64;  // global compartido (lo escribe el hilo hijo)

i64 worker(u64 param) {
	t       = 99; // muta SOLO la copia de ESTE hilo
	g_child = t;  // publicar al global compartido
	return 0;
}

i64 main() {
	cfn(u64) -> i64 fp = worker;
	u64            h  = CreateThread(0, 0, (u64)fp, 0, 0, 0);
	WaitForSingleObject(h, 4_294_967_295); // INFINITE
	return t * 1000 + g_child;             // 11 (aislado) * 1000 + 99
}
