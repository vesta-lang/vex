//  Embed Inc 2: interpolacion `"${...}"` en value-strings nativos (AOT).
// Construye UN value-string concatenando las partes literales con cada
// `${expr}` appendado in-place al buffer (grow/realloc).  Sin GC, sin
// StringObject, sin helper nativo del runtime.  RAII libera el resultado y
// los temporales del append.  Validado por ejecucion.
//
// Tipos soportados en esta entrega: string, char, int (i8..u64) y bool.
// La conversion int->texto (itoa) y bool->texto viven en FUNCIONES HELPER
// nativas (__vx_itoa_s/_u, __vx_btoa) en vez de inline: asi el optimizer
// no foldea el loop/branch mid-expression cuando el argumento es constante
// (el const-fold del itoa INLINE producia longitudes erroneas con un
// argumento literal).  Por tener varios bloques (loops/branch) el inliner
// tampoco los re-inlinea, preservando la correccion.
//
// Cada caso valida length + bytes; el primero que falle devuelve un codigo
// negativo distinto.  Exit-code 99 confirma los 8 casos.

i64 compute() {
	// Suma 42 en un loop -> el optimizer NO foldea: el int interpolado es
	// "runtime", probando el camino dinamico del itoa.
	i64 acc = 0_i64;
	i64 i   = 0_i64;
	while (i < 42) {
		acc++;
		i = i + 1;
	}
	return acc;
}

i32 main() {
	// (1) string + char: "hola Vesta mundo!" -> 17, p[16]='!'(33).
	//
	// `name` lleva valor A PROPOSITO: con la cadena vacia esto no comprobaba
	// que la parte de cadena se anadiera -- salia lo mismo interpolandola que
	// ignorandola --.  Aqui estuvo el nombre viejo del lenguaje; al retirarlo
	// se dejo en "" y los numeros se quedaron como estaban, asi que el ejemplo
	// afirmaba 15 donde la respuesta correcta eran 12.
	string name = "Vesta";
	char   excl = '!';
	string m1   = "hola ${name} mundo${excl}";
	char*  p1   = m1.cstr();
	if (m1.length() != 17) { return -1; }
	if (p1[16] != 33) { return -2; }

	// (2) int CONSTANTE: "n=42" -> 4, bytes 'n','=','4','2'.
	i64    n  = 42_i64;
	string m2 = "n=${n}";
	char*  p2 = m2.cstr();
	if (m2.length() != 4) { return -3; }
	if (p2[2] != 52) { return -4; } // '4'
	if (p2[3] != 50) { return -5; } // '2'

	// (3) int CONSTANTE solo: "42" -> 2.
	string m3 = "${n}";
	if (m3.length() != 2) { return -6; }

	// (4) int NEGATIVO: "-5" -> 2, bytes '-','5'.
	i64    neg = -5_i64;
	string m4  = "${neg}";
	char*  p4  =  m4.cstr();
	if (m4.length() != 2) { return -7; }
	if (p4[0] != 45) { return -8; } // '-'
	if (p4[1] != 53) { return -9; } // '5'

	// (5) int CERO: "0" -> 1, byte '0'.
	string m5 = "${0}";
	char*  p5 = m5.cstr();
	if (m5.length() != 1) { return -10; }
	if (p5[0] != 48) { return -11; } // '0'

	// (6) int RUNTIME (compute()==42): "v=42" -> 4.
	i64    rv = compute();
	string m6 = "v=${rv}";
	if (m6.length() != 4) { return -12; }

	// (7) bool true: "true" -> 4, byte 't'.
	bool   bt = true;
	string m7 = "${bt}";
	char*  p7 = m7.cstr();
	if (m7.length() != 4) { return -13; }
	if (p7[0] != 116) { return -14; } // 't'

	// (8) bool false: "false" -> 5, byte 'f'.  Mixto: "a=7 b=X c=!" -> 11.
	bool   bf = false;
	string m8 = "${bf}";
	char*  p8 = m8.cstr();
	if (m8.length() != 5) { return -15; }
	if (p8[0] != 102) { return -16; } // 'f'

	i64    a   = 7_i64;
	string sb  = "X";
	char   c   = '!';
	string mix = "a=${a} b=${sb} c=${c}";
	if (mix.length() != 11) { return -17; }

	return 99; // los 8 casos pasaron
}
