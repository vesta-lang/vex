// ASA: LIFT de atomicos escritos en asm a IR tipado.  Un bloque `asm { }`
// ANALIZABLE cuya semantica es un atomico conocido (lock cmpxchg / lock xadd) se
// baja al MISMO op tipado del IR que el builtin (ATOMIC_CAS_I64 / ATOMIC_ADD_I64)
// en lugar de una caja opaca: el interprete lo ejecuta como opcode (sin
// trampolin), el JIT/AOT con la instruccion atomica nativa, y el analizador lo
// entiende.  Se escribe la primitiva en asm (visible) y se obtiene lo mejor de
// los dos mundos.
//
//     vm --vx 16_atomic_lift.vx -o atomic
//     vm --run atomic.velb            # interp
//     vm --run atomic.velb -m jit     # JIT (mismo resultado)
//
// @expect 42
namespace ejemplos.asmlift;
i64 g = 100_i64;
i64 h = 10_i64;
i64 main() {
	// compare-and-swap: si g==100 -> g=200, old=100 (valor viejo).
	register("rdi") u64* p   = (u64*)&g;
	register("rsi") u64  des = 200_u64;
	register("rax") u64  old = 100_u64; // in: expected ; out: old value
	asm {
		lock cmpxchg [rdi], rsi
	} clobbers("flags");

	// fetch-and-add: old2 = g_h ; h += 5.
	register("rcx") u64* q    = (u64*)&h;
	register("rdx") u64  old2 = 5_u64; // in: delta ; out: old value
	asm {
		lock xadd [rcx], rdx
	} clobbers("flags");

	if (old == 100 && g == 200 && old2 == 10 && h == 15) return 42;
	return (i64)(old * 1000 + old2);
}
