namespace ejemplos.fiber_stackful;

// 236_fiber_stackful.vx
//
// FN.3 (2o test, mas rico): TRES fibras stackful con ESTADO LOCAL que sobrevive
// a MULTIPLES yields.  A diferencia de 235 (que acumula en globales), aqui cada
// fibra mantiene un acumulador LOCAL `acc` en SU PROPIA pila; el valor persiste a
// traves de dos `fiber_swapctx` (cede/reanuda), demostrando que el context-switch
// preserva la pila completa de cada fibra en los tres modos.
//
// Cada fibra i (i = 1,2,3) hace `acc = acc*10 + i` tres veces (cediendo entre
// medias) -> acc = i*111 (111, 222, 333).  main suma los tres resultados:
//   111 + 222 + 333 = 666 (=0x29a).
//   -m vm  : R00 = 0x29a
//   -m jit : R00 = 0x29a (identico)
//   -m aot : exit = 666 & 0xFF = 154
//
// Mismo modelo mode-aware que 235: contexto/pila globales (VM en interp, nativo en
// aot) con override a memoria HOST + trampolin en JIT (via los externs vrt:*).

extern "vrt" {
	fn jit_active() -> i32;
	fn fiber_jit_ctx(u64 entry) -> u64;
	fn fiber_jit_scratch() -> u64;
}

// Tres contextos + tres pilas + el contexto del scheduler.
i64[19]  __ctx_sched;
i64[19]  __ctx_a;
i64[19]  __ctx_b;
i64[19]  __ctx_c;
i64[512] __stk_a;
i64[512] __stk_b;
i64[512] __stk_c;

// Handles (direccion de contexto real por modo).
u64 __h_sched;
u64 __h_a;
u64 __h_b;
u64 __h_c;

// Resultados escritos por cada fibra desde su acumulador LOCAL + banderas.
i64 __res_a  = 0_i64;
i64 __res_b  = 0_i64;
i64 __res_c  = 0_i64;
i64 __done_a = 0_i64;
i64 __done_b = 0_i64;
i64 __done_c = 0_i64;

// Cuerpo de la fibra A (id 1).  `acc` es LOCAL (vive en la pila de A) y debe
// conservar su valor a traves de los dos yields intermedios.
void fiber_a() {
	i64 acc = 0_i64;
	acc = acc * 10 + 1;
	fiber_swapctx(__h_a, __h_sched); // cede (acc = 1)
	acc = acc * 10 + 1;
	fiber_swapctx(__h_a, __h_sched); // cede (acc = 11)
	acc      = acc * 10 + 1;         // acc = 111
	__res_a  = acc;
	__done_a = 1;
	fiber_swapctx(__h_a, __h_sched); // termina
}

void fiber_b() {
	i64 acc = 0_i64;
	acc = acc * 10 + 2;
	fiber_swapctx(__h_b, __h_sched);
	acc = acc * 10 + 2;
	fiber_swapctx(__h_b, __h_sched);
	acc      = acc * 10 + 2; // acc = 222
	__res_b  = acc;
	__done_b = 1;
	fiber_swapctx(__h_b, __h_sched);
}

void fiber_c() {
	i64 acc = 0_i64;
	acc = acc * 10 + 3;
	fiber_swapctx(__h_c, __h_sched);
	acc = acc * 10 + 3;
	fiber_swapctx(__h_c, __h_sched);
	acc      = acc * 10 + 3; // acc = 333
	__res_c  = acc;
	__done_c = 1;
	fiber_swapctx(__h_c, __h_sched);
}

i32 main() {
	i64 top_a = (i64)((u64)&__stk_a[0] + 4096);
	i64 top_b = (i64)((u64)&__stk_b[0] + 4096);
	i64 top_c = (i64)((u64)&__stk_c[0] + 4096);

	// Modelo interp/aot: contexto global.
	__ctx_a[0] = (i64) fiber_entry(fiber_a);
	__ctx_a[1] = top_a;
	__ctx_a[2] = top_a;
	__ctx_b[0] = (i64) fiber_entry(fiber_b);
	__ctx_b[1] = top_b;
	__ctx_b[2] = top_b;
	__ctx_c[0] = (i64) fiber_entry(fiber_c);
	__ctx_c[1] = top_c;
	__ctx_c[2] = top_c;
	__h_sched  = (u64)&__ctx_sched[0];
	__h_a      = (u64)&__ctx_a[0];
	__h_b      = (u64)&__ctx_b[0];
	__h_c      = (u64)&__ctx_c[0];

	// Modelo JIT: override host + trampolin + proc.
	if (jit_active()) {
		__h_sched = fiber_jit_scratch();
		__h_a     = fiber_jit_ctx(fiber_entry(fiber_a));
		__h_b     = fiber_jit_ctx(fiber_entry(fiber_b));
		__h_c     = fiber_jit_ctx(fiber_entry(fiber_c));
	}

	// Round-robin: dale un quantum a cada fibra viva hasta que las tres terminen.
	i64 alive_a = 1_i64;
	i64 alive_b = 1_i64;
	i64 alive_c = 1_i64;
	while (alive_a == 1 || alive_b == 1 || alive_c == 1) {
		if (alive_a == 1) {
			fiber_swapctx(__h_sched, __h_a);
			if (__done_a == 1) { alive_a = 0; }
		}
		if (alive_b == 1) {
			fiber_swapctx(__h_sched, __h_b);
			if (__done_b == 1) { alive_b = 0; }
		}
		if (alive_c == 1) {
			fiber_swapctx(__h_sched, __h_c);
			if (__done_c == 1) { alive_c = 0; }
		}
	}

	return (i32)(__res_a + __res_b + __res_c); // 111 + 222 + 333 = 666
}
