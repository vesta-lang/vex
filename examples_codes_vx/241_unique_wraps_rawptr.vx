namespace ejemplos.unique_wraps_rawptr;

// combo memoria: unique<T*> que envuelve un PUNTERO RAW (bug2).
// Un `i64*` es un VALOR de 8 bytes (no un host_ptr a un objeto gestionado),
// asi que unique_box lo caja en una celda heap de 8 bytes.  `ptr_of(u)`
// devuelve `i64**` (la celda) y `*ptr_of(u)` recupera el `i64*` con un LOAD.
// Antes: se trataba como host_ptr-a-objeto y `*ptr_of` deref-eaba el VALOR del
// puntero como si fuera una direccion de slot -> SIGSEGV en los 3 modos.
// Esperado: R0 = 42 en los 3 modos.
i32 main() {
	i64*         raw = (i64*) malloc(8);
	*            raw = 42;
	unique<i64*> u   = unique_box(raw);
	i64*         got = *ptr_of(u);
	return (i32)*got;
}
