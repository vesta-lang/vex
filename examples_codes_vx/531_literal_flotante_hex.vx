namespace ejemplos.literal_flotante_hex;

// El literal flotante HEXADECIMAL, la tercera forma de escribir un `f64`.
//
//     0x1.8p+1     mantisa en hexadecimal, exponente en BASE 2 y en decimal
//
// Se lee: (1 + 8/16) * 2^1 = 1.5 * 2 = 3.0.  El exponente `p` es OBLIGATORIO,
// igual que en C: sin el no hay literal flotante hexadecimal, y lo que quede es
// un entero.
//
// PARA QUE SIRVE, que es lo que justifica tenerlo: escribir una constante de
// coma flotante con sus BITS EXACTOS.  Un literal decimal como `0.1` no vale
// para eso -- no existe en binario, se guarda el mas cercano --, asi que cuando
// lo que importa es el patron de bits, esta es la unica forma de decirlo sin
// ambiguedad.
//
// El punto NO se come al acceso a campo: un `.` detras de un entero hexadecimal
// solo forma parte del numero si detras viene el exponente.  El lexer lo mira
// SIN consumir antes de decidir.
//
// Resultado esperado: 42.

i32 main() {
	f64 tres  = 0x1.8p+1_f64; // (1 + 8/16) * 2^1 = 3.0
	f64 medio = 0x1p-1_f64;   // 1 * 2^-1 = 0.5   (sin parte fraccionaria)
	f64 ocho  = 0X1.0P+3_f64; // 1 * 2^3 = 8.0    (en mayusculas tambien)

	// Y los enteros hexadecimales siguen siendo enteros.
	i64 ff  = 0xFF_i64;
	i64 dis = 0x1_0; // el separador `_` vale igual

	if (tres != 3.0) {
		println("la forma con parte fraccionaria: ${tres}, esperaba 3");
		return 1_i32;
	}
	if (medio != 0.5) {
		println("la forma sin parte fraccionaria: ${medio}, esperaba 0.5");
		return 2_i32;
	}
	if (ocho != 8.0) {
		println("en mayusculas: ${ocho}, esperaba 8");
		return 3_i32;
	}
	if (ff != 255 || dis != 16) {
		println("los enteros hexadecimales se rompieron: ${ff} ${dis}");
		return 4_i32;
	}

	println("literal flotante hex: ${tres} ${medio} ${ocho}");
	return 42_i32;
}
