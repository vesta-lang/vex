namespace ejemplos.desbordamiento_entero;

// Una cuenta entera que NO CABE en su tipo es un error, y el cast es como se
// declara que envolver era la intencion.
//
//     i8 max = 127;
//     max = max + 1;        // error: 128 se sale de i8
//     max = (i8)(max + 1);  // vale: lo he dicho
//
// Envolver es legitimo -- lo usan las mezclas de un hash, las sumas de
// comprobacion y los generadores pseudoaleatorios --, pero tiene que DECIRSE,
// igual que cualquier otra conversion que pierde informacion.  Antes salia
// -128 sin que constara en ningun sitio: envolver sin querer no da un fallo,
// da otro numero, y eso no se ve hasta mucho despues.
//
// Se mira el intermedio de ANTES de optimizar, a proposito: es lo que el
// usuario escribio, y asi la regla no depende del nivel de optimizacion -- si
// dependiera, el mismo programa seria valido o no segun como se compile, que
// es lo peor que le puede pasar a una regla del lenguaje.
//
// Y solo se rechaza lo DEMOSTRADO: con los dos operandos sabidos.  Sobre un
// valor que viene de fuera no se dice nada -- "no poder demostrar que cabe" no
// es "demostrar que no cabe", y un error falso es mucho peor que un hueco.
//
// Resultado esperado: 42.

// Las tres formas de salirse, las tres declaradas con su cast.
i8 pasa_de_i8() {
	i8 max = 127_i8;
	return (i8)(max + 1_i8);
}

i8 baja_de_i8() {
	i8 min = -128_i8;
	return (i8)(min - 1_i8);
}

i16 pasa_de_i16() {
	i16 grande = 30_000_i16;
	return (i16)(grande * 2_i16);
}

// Lo que NUNCA se rechaza: envolver sobre un valor que el compilador no
// conoce.  Es la mezcla de un hash, y exigirle un cast seria pedirlo en todas
// partes por si acaso.
u32 mezclar(u32 semilla) {
	u32 h = semilla * 2_654_435_761_u32;
	return h + 374_761_393_u32;
}

// Y lo que CABE justo, que tampoco necesita nada.
i8 cabe() {
	i8 a = 100_i8;
	return a + 27_i8;
}

i32 main() {
	// Envolver sigue haciendo lo de siempre; lo que cambia es que consta.
	//
	// OJO: no se compara ningun valor envuelto contra su literal.  Un
	// resultado que se sale se queda SIN NORMALIZAR a su ancho -- `127_i8 + 1`
	// deja 128 en el registro, no -128 --, asi que `pasa_de_i8() == -128_i8`
	// responde `false` aunque las dos cosas se impriman igual.  Es un fallo
	// APARTE, y hornearlo en una prueba lo taparia.
	if (cabe() != 127_i8) {
		println("(1) ${cabe()}, esperaba 127");
		return 1_i32;
	}
	if (mezclar(7_u32) == 0_u32) {
		println("(2) la mezcla dio cero");
		return 2_i32;
	}
	println("desbordamiento: ${pasa_de_i8()} ${baja_de_i8()} ${pasa_de_i16()}");
	return 42_i32;
}
