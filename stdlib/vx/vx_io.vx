// vx_io.vx -- runtime de I/O nativo para  AOT (tiers bare/embed) SIN libc
// de formato.  Auto-bundle: el driver -m aot lo fusiona cuando el modulo usa
// print/println y no define las primitivas el mismo (mismo patron que
// vx_exc.vx para excepciones).
//
// Solo `__vx_write`/`__vx_flush` tocan el SO; lo hacen via FFI a la I/O de
// bajo nivel basada en descriptor de fichero (fd 1 = stdout), que la IAT/GOT
// del linker AOT resuelve contra msvcrt.dll (Windows) o libc.so.6 (POSIX).  Sin
// `stdout` (FILE*) ni printf: solo write/_write.  Los formateadores numericos
// estan en  puro sobre __vx_write -> portables a cualquier target.
//
// El usuario puede REDEFINIR cualquier `__vx_*` en su propio modulo (igual que
// @AllocatorOverride): si lo define, el lowering llama a SU version y este
// runtime no se bundle-a (o su simbolo queda sin usar y el dead-elim lo quita).

// Del lado de Linux nada se escribe a mano: las llamadas vienen de
// std.syscall, sus constantes de std.unix y sus tipos de std.types.  Escribir
// aqui otra copia -- el numero de syscall, el valor de una bandera o un `i64`
// donde el sistema dice `ssize_t` -- seria tener la misma verdad en dos sitios.
// Los imports van con @Target porque en Windows estos nombres no existen: alli
// la superficie del sistema es la de NT.
@Target("os:linux")
import std.syscall.linux only open, read, close, write;
@Target("os:linux")
import std.unix only O_RDONLY, STDOUT_FILENO;
@Target("os:linux")
import std.types only ssize_t;

// Terminar el proceso SI es igual en los dos sistemas, asi que no lleva
// @Target: std.os ya elige por dentro con que llamada se hace.
// `Stream` para nombrar la salida de ERROR (ver __vx_uncaught_report); lo demas
// de aqui sale por la estandar y bufferizada.
//
// El `write` portable NO se importa: en Linux este modulo ya trae el crudo del
// sistema con ese mismo nombre (`std.syscall.linux`), y traer los dos hace que
// escribir `write` deje de significar una sola cosa -- el compilador lo dice y
// no compila.  Se llama cualificado donde hace falta.
import std.os only exit, Stream;

// --- FFI a la I/O de bajo nivel del SO (resuelta por IAT/GOT) ---------------
// @Target no aplica a bloques `extern`; declaramos los de AMBAS plataformas sin
// condicion y el `__vio_raw` @Target'd llama solo al de su plataforma -> el
// extern no usado lo elimina el dead-strip (no se importa).
//
// Windows: SOLO kernel32, CERO msvcrt bajo ninguna circunstancia.  Replica
// exactamente a vesta_io.c -- consola: UTF-8 -> UTF-16 (MultiByteToWideChar) +
// WriteConsoleW (rinde Unicode en consolas legacy); pipe/redir: WriteFile de
// bytes directo.  panic via ExitProcess.  Sin printf/fwrite/stdio/CRT.
// Linux: `write` de libc (thin syscall stub; el raw `syscall` necesitaria
// inline-asm AOT,  AS).
extern "kernel32.dll" {
	fn GetStdHandle(u32 nStdHandle) -> u64;
	fn GetConsoleMode(u64 hConsole, u32* lpMode) -> i32;
	fn WriteFile(
		u64 hFile,
		u8* buf,
		u32 n,
		u32* nwritten,
		u64 overlapped
	) -> i32;
	fn WriteConsoleW(u64 hConsole, u16* buf, u32 nchars, u32* nwritten,
		u64 reserved) -> i32;
	fn MultiByteToWideChar(u32 codePage, u32 flags, u8* mbStr, i32 cbMb,
		u16* wStr, i32 cchWide) -> i32;
	fn ExitProcess(u32 code) -> void;
	fn IsDebuggerPresent() -> i32;
}

// Linux: las llamadas al sistema vienen de std.syscall, que es donde vive la
// tabla.  Aqui habia dos copias escritas a mano -- una por arquitectura, con
// los numeros y los registros a pelo -- y eso era tener la misma verdad en dos
// sitios: el dia que un numero cambie o llegue una arquitectura nueva hay que
// acordarse de este fichero.  std.syscall ya resuelve el reparto por
// arquitectura (`syscall` frente a `int 0x80`, y sus tablas distintas) por su
// cuenta, que es justo lo que aqui se estaba duplicando.

// --- Sink de stdout con block-buffering -------------------------------------
// __vio_raw: escritura cruda al SO (la unica parte platform-specific).  Recibe
// como mucho VIO_BUF_BYTES (el flush nunca pasa mas), asi la conversion a
// UTF-16 cabe en __vio_wbuf sin malloc.
u64       __vio_handle = 0_u64;
i32       __vio_is_console = 0_i32; // 0=sin-detectar, 1=consola, 2=fichero/pipe
u16[4096] __vio_wbuf;               // buffer UTF-16 (max VIO_BUF_BYTES code units: ASCII)

@Target("os:windows")
void __vio_raw(u8* buf, u64 len) {
	if (len == 0) return;
	if (__vio_is_console == 0) {
		// STD_OUTPUT_HANDLE = (DWORD)-11 = 0xFFFFFFF5 = 4294967285.
		__vio_handle = GetStdHandle(4_294_967_285);
		u32 mode = 0_u32;
		// GetConsoleMode != 0 <=> el handle es una consola (no pipe/fichero).
		if (GetConsoleMode(__vio_handle, &mode) != 0) {
			__vio_is_console = 1;
		} else {
			__vio_is_console = 2;
		}
	}
	u32 nw = 0_u32;
	if (__vio_is_console == 1) {
		// Consola: UTF-8 (CP_UTF8=65001) -> UTF-16 -> WriteConsoleW.  len <=
		// VIO_BUF_BYTES (4096) -> a lo sumo 4096 code units (caso ASCII).
		i32 ncw = MultiByteToWideChar(65_001, 0, buf, (i32)len, &__vio_wbuf[0],
			4096);
		if (ncw > 0) {
			WriteConsoleW(__vio_handle, &__vio_wbuf[0], (u32)ncw, &nw, 0);
			return;
		}
	// Conversion fallida -> caer a bytes crudos.
	}
	// Pipe/redir (o fallback): WriteFile de bytes directo.
	WriteFile(__vio_handle, buf, (u32)len, &nw, 0);
}
@Target("!os:windows")
void __vio_raw(u8* buf, u64 len) {
	if (len > 0) write(STDOUT_FILENO, (char*) buf, len);
}

// Buffer de salida (block-buffered): acumula y vuelca en UN syscall.  Bate a
// fwrite/printf de C (sin parseo de formato; 1 syscall por bloque).  El driver
// -m aot inyecta __vx_flush() antes de cada RET de main (y __vx_panic_null
// vuelca antes de salir) -> nada se pierde al terminar.  SIEMPRE bufferiza
// (sin bypass directo) para que el flush nunca pase mas de VIO_BUF_BYTES y la
// conversion UTF-16 de consola quepa en __vio_wbuf.
u8[4096] __vio_buf;
u64      __vio_pos = 0_u64;

void __vx_flush() {
	if (__vio_pos > 0) {
		__vio_raw(&__vio_buf[0], __vio_pos);
		__vio_pos = 0;
	}
}

void __vx_write(u8* buf, u64 len) {
	u64 off = 0_u64;
	while (off < len) {
		if (__vio_pos >= 4096) __vx_flush();
		u64               space = 4096 - __vio_pos;
		u64               take  = len - off;
		if (take > space) take  = space;
		u64               k     = 0_u64;
		while (k < take) {
			__vio_buf[__vio_pos + k] = buf[off + k];
			k                        = k + 1;
		}
		__vio_pos = __vio_pos + take;
		off       = off + take;
	}
}

// --- panic ------------------------------------------------------------------
//
// Lo unico que cambia entre sistemas es la llamada con la que se termina el
// proceso: ExitProcess en Windows, exit_group en Linux.  Todo lo demas (el
// mensaje, el vaciado del buffer y la trampa para el depurador) es comun, asi
// que vive en un solo sitio y solo la ultima linea esta por duplicado.

/**
 * @brief Indica si un depurador esta siguiendo al proceso.
 *
 * Se consulta para decidir si `panic` deja una trampa.  Sin depurador la
 * trampa mataria el proceso con SIGTRAP y el programa dejaria de salir con el
 * mismo codigo que dan el interprete y el JIT.
 *
 * @return 1 si hay depurador, 0 si no o si no se pudo averiguar.
 */
@Target("os:windows")
i32 __vio_trazado() { return IsDebuggerPresent(); }

/**
 * @brief Version de Linux: no hay llamada que lo diga.
 *
 * Se lee el campo `TracerPid` de `/proc/self/status`, que vale 0 mientras
 * nadie siga al proceso y pasa a ser el pid del depurador cuando alguien se
 * engancha.
 *
 * @return 1 si hay depurador, 0 si no o si el fichero no se pudo leer.
 */
@Target("os:linux")
i32 __vio_trazado() {
	char[512] buf;
	i32       fd = open("/proc/self/status", O_RDONLY, 0);
	if (fd < 0) return 0;
	ssize_t n = read(fd, &buf[0], 512);
	close(fd);
	if (n <= 0) return 0;
	// Basta con mirar el primer caracter del numero: interesa si es cero, no
	// cuanto vale.
	ssize_t tope = n - 10;
	for (ssize_t i = 0; i < tope; i++) {
		if (buf[i] != 'T') continue;
		if (buf[i + 1] != 'r') continue;
		if (buf[i + 6] != 'P') continue;
		if (buf[i + 9] != ':') continue;
		ssize_t j = i + 10;
		while (j < n && (buf[j] == ' ' || buf[j] == '\t')) j++;
		if (j < n && buf[j] != '0') return 1;
		return 0;
	}
	return 0;
}

/// En un target sin sistema operativo no hay a quien preguntar.
@Target("!os:windows && !os:linux")
i32 __vio_trazado() { return 0; }

/**
 * @brief Hook por defecto de `panic(msg)`.
 *
 * Escribe el mensaje que puso el programador y termina.  Antes de terminar
 * deja un `int3` si hay un depurador enganchado, para que pare EN el punto del
 * fallo y con el mensaje ya escrito: un `panic` tambien es informacion de
 * diagnostico, no solo una forma de morir.
 *
 * Un `@PanicHandler` del usuario sustituye a esta funcion por completo.
 *
 * @param msg Bytes del mensaje.  No termina en nul: viene con su longitud.
 * @param len Cuantos bytes tiene el mensaje.
 */
void __vio_panic_di(u8* msg, u64 len) {
	__vx_write("panic: ", 7);
	__vx_write(msg, len);
	__vx_write("\n", 1);
	__vx_flush(); // el mensaje sale antes de parar o de morir.
	if (__vio_trazado() != 0) {
		asm volatile { int3 };
	}
}

/// Hook por defecto de `panic(msg)`.  Sale con 134 (128+6, SIGABRT), el mismo
/// codigo con que salen el interprete y el JIT.
void __panic(u8* msg, u64 len) {
	__vio_panic_di(msg, len);
	exit(134);
}

/// Hook de fallo de `unwrap` sobre null (Optional/nonnull vacios).  Es un
/// panic como cualquier otro, solo que el mensaje lo pone el lenguaje.
void __vx_panic_null() {
	// La longitud la cuenta el compilador (se pliega a una constante), no yo:
	// este mismo mensaje llevaba 54 escrito a mano donde mide 56, asi que
	// salia cortado y sin el salto de linea.
	__vio_panic_di("unwrap de un valor null (Optional/nonnull vacio)",
		"unwrap de un valor null (Optional/nonnull vacio)".bytes());
	exit(134);
}

/// Lo que se hace con una excepcion que nadie recogio, CUANDO HAY SISTEMA.
///
/// El gancho es `__vx_uncaught`, y vive en el runtime de excepciones
/// (`vx_exc.vx`), que no importa nada: sin sistema lo unico que se puede hacer
/// es parar la maquina.  Aqui esta lo otro -- contarlo --, en el modulo que
/// sabe escribir; el driver antepone esta llamada al gancho cuando incluye
/// este runtime.  Asi los dos se enlazan por separado y un objeto freestanding
/// no arrastra la I/O del sistema por usar try/catch.
///
/// Se vuelca ANTES de decir nada: la salida va por bloques, y sin esto se
/// perdia todo lo que el programa llevara impreso -- que suele ser justo lo que
/// dice como llego hasta ahi.
///
/// Sale con 134, el mismo codigo que el interprete y el JIT ante lo mismo.  No
/// vuelve.
void __vx_uncaught_report() {
	__vx_flush();
	// Por la salida de ERROR: es un fallo, y quien encadene la salida del
	// programa con otra cosa no debe tragarselo mezclado con los datos.
	//
	// No se nombra la clase porque aqui no se sabe: en nativo una excepcion es
	// un valor y un identificador de tipo, no un objeto con metadatos.  El
	// interprete y el JIT si la nombran.
	std.os.write(Stream.stderr, "uncaught exception\n",
		"uncaught exception\n".bytes());
	exit(134);
}

// --- Formateadores numericos ( puro sobre __vx_write) -------------------

// Emite `v` en decimal sin signo.  Buffer de 20 digitos (u64 max = 20).
void __vio_dec_u64(u64 v) {
	u8[24] buf;
	if (v == 0) {
		buf[0] = 48; // '0'
		__vx_write(&buf[0], 1);
		return;
	}
	i32 i = 24_i32;
	while (v > 0) {
		i      = i - 1;
		buf[i] = (u8)(48 + (v % 10)); // '0' + digito
		v      = v / 10;
	}
	u64 n = (u64)(24 - i);
	__vx_write(&buf[i], n);
}

void __vx_print_u64(u64 v) { __vio_dec_u64(v); }

void __vx_print_i64(i64 v) {
	if (v < 0) {
		__vx_write("-", 1);
		// -v puede desbordar en INT64_MIN; en u64 el complemento es correcto.
		u64 mag = (u64)(0 - v);
		__vio_dec_u64(mag);
	} else {
		__vio_dec_u64((u64)v);
	}
}

// Emite `v` en base `radix` (8/16) sin prefijo.  Digitos 0-9a-f.
void __vio_base_u64(u64 v, u64 radix) {
	u8[68] buf;
	if (v == 0) {
		buf[0] = 48; // '0'
		__vx_write(&buf[0], 1);
		return;
	}
	i32 i = 68_i32;
	while (v > 0) {
		u64 d = v % radix;
		i = i - 1;
		if (d < 10) {
			buf[i] = (u8)(48 + d); // '0'+d
		} else {
			buf[i] = (u8)(87 + d); // 'a'-10 + d = 87 + d
		}
		v = v / radix;
	}
	u64 n = (u64)(68 - i);
	__vx_write(&buf[i], n);
}

void __vx_print_hex(u64 v) {
	__vx_write("0x", 2);
	__vio_base_u64(v, 16);
}

void __vx_print_oct(u64 v) {
	__vx_write("0o", 2);
	__vio_base_u64(v, 8);
}

void __vx_print_ptr(u64 v) {
	__vx_write("0x", 2);
	__vio_base_u64(v, 16);
}

void __vx_print_bin(u64 v) {
	__vx_write("0b", 2);
	u8[68] buf;
	if (v == 0) {
		buf[0] = 48; // '0'
		__vx_write(&buf[0], 1);
		return;
	}
	i32 i = 68_i32;
	while (v > 0) {
		i      = i - 1;
		buf[i] = (u8)(48 + (v & 1)); // '0' o '1'
		v      = v >> 1;
	}
	u64 n = (u64)(68 - i);
	__vx_write(&buf[i], n);
}

void __vx_print_bool(u64 v) {
	if (v != 0) {
		__vx_write("true", 4);
	} else {
		__vx_write("false", 5);
	}
}

// Codepoint Unicode -> UTF-8 (1..4 bytes).
void __vx_print_char(u64 cp) {
	u8[4] b;
	if (cp < 128) {
		b[0] = (u8)cp;
		__vx_write(&b[0], 1);
	} else if (cp < 2048) {
		b[0] = (u8)(192 | (cp >> 6));
		b[1] = (u8)(128 | (cp & 63));
		__vx_write(&b[0], 2);
	} else if (cp < 65_536) {
		b[0] = (u8)(224 | (cp >> 12));
		b[1] = (u8)(128 | ((cp >> 6) & 63));
		b[2] = (u8)(128 | (cp & 63));
		__vx_write(&b[0], 3);
	} else {
		b[0] = (u8)(240 | (cp >> 18));
		b[1] = (u8)(128 | ((cp >> 12) & 63));
		b[2] = (u8)(128 | ((cp >> 6) & 63));
		b[3] = (u8)(128 | (cp & 63));
		__vx_write(&b[0], 4);
	}
}

// Float f64 en formato aproximado a "%g": signo, parte entera, hasta 6
// decimales con recorte de ceros finales.  Cubre el rango normal
// (|v| < 1.8e19); valores enormes/diminutos que %g daria en notacion
// cientifica se imprimen en decimal (limitacion documentada).  NaN/Inf
// explicitos.  Iguala la salida de vesta_io.c (%g) para los magnitudes
// tipicas de la stdlib de math (sqrt/pow/log/...).
void __vx_print_float(f64 v) {
	// NaN: v != v solo es cierto para NaN.
	if (v != v) {
		__vx_write("nan", 3);
		return;
	}
	if (v < 0.0) {
		__vx_write("-", 1);
		v = 0.0 - v;
	}
	// Infinito: mayor que el mayor finito representable aprox.
	if (v > 1.7976931348623157e308) {
		__vx_write("inf", 3);
		return;
	}
	if (v == 0.0) {
		__vx_write("0", 1);
		return;
	}
	// Rango fuera de u64 (|v| >= 2^63): decimal sin fraccion (best-effort).
	if (v >= 9_223_372_036_854_775_808.0) {
		// Dividir en bloques no es trivial sin u128; emitimos el entero
		// truncado por mantissa (suficiente para no perder el orden de
		// magnitud).  %g usaria %e aqui (limitacion conocida).
		u64 big = (u64)v;
		__vio_dec_u64(big);
		return;
	}
	u64 ip   = (u64)v;
	f64 frac = v - (f64)ip;
	__vio_dec_u64(ip);
	if (frac > 0.0) {
		u8[8] fb;
		i32   n = 0_i32;
		while (n < 6) {
			frac = frac * 10.0;
			u64        d = (u64)frac;
			if (d > 9) d = 9;
			fb[n] = (u8)(48 + d); // '0' + digito
			frac  = frac - (f64)d;
			n     = n + 1;
		}
		// Recortar ceros finales (estilo %g).
		while (n > 0 && fb[n - 1] == 48) n = n - 1;
		if (n > 0) {
			__vx_write(".", 1);
			__vx_write(&fb[0], (u64)n);
		}
	}
}

// Padding: escribe `count` copias del codepoint `fill_cp` (alineacion de
// columnas en ${s:>W} / ${s:<W}).  fill_cp suele ser ' ' (32) o '.'.
void __vx_pad(u64 fill_cp, u64 count) {
	u64 k = 0_u64;
	while (k < count) {
		__vx_print_char(fill_cp);
		k = k + 1;
	}
}

// Cadena C nul-terminada (host_ptr): mide la longitud y escribe.
void __vx_print_cstr(u8* s) {
	if (s == null) return;
	u64               n = 0_u64;
	while (s[n] != 0) n = n + 1;
	if (n > 0) __vx_write(s, n);
}
