// ===========================================================================
// Runtime de excepciones NATIVO de Vesta, escrito EN VX (auto-hospedado).
//
// Sin GC, sin VM, sin libc.  Modelo setjmp/longjmp con una pila de frames:
//   - __vx_setjmp / __vx_longjmp: @Naked + inline asm (la unica parte
//     irreduciblemente en ensamblador; salva/restaura callee-saved + sp + ip).
//     Tres variantes por @Target: SysV x86-64, Win64 x86-64 y x86-32 cdecl.
//   - __vx_push_frame / __vx_pop_frame / __vx_throw / __vx_get_value:
//     VX puro, sobre el estado global (puntero al top de la pila + valor de la
//     excepcion activa) reservado en una seccion .vxexc y accedido con
//     section_start + punteros raw.  Offsets parametricos por target.
//
// El compilador (lowering de try/catch en -m aot) baja a CALLs a estas
// funciones.  Se enlaza estatico por defecto.
//
// Layout del frame (lo aloca el caller en su pila):
//   [0 .. VX_BUF_SIZE)            jmp_buf  (callee-saved + sp + ip)
//   [VX_PREV_OFF .. +VX_PTR)     prev     (frame anterior)
//   [VX_TYPE_OFF .. +VX_PTR)     type     (tipo del catch; 0 = catch-all)
//
// v1: type matching = catch-all (al top); subtype = v2.
// ===========================================================================

// --- Parametros de layout segun el target del binario (no del host) ---
// Tamano del jmp_buf:  SysV = 8 regs*8 = 64;  Win64 = 10 regs*8 = 80;
// x86-32 = 6 regs*4 = 24.
@Target("arch:x86_64 && os:windows")
comptime i64 VX_BUF_SIZE = 80_i64;
@Target("arch:x86_64 && !os:windows")
comptime i64 VX_BUF_SIZE = 64_i64;
@Target("arch:x86")
comptime i64 VX_BUF_SIZE = 24_i64;

// Tamano de puntero del target.
@Target("arch:x86_64")
comptime i64 VX_PTR = 8_i64;
@Target("arch:x86")
comptime i64 VX_PTR = 4_i64;

// Offsets de los campos prev/type tras el jmp_buf.
@Target("arch:x86_64 && os:windows")
comptime i64 VX_PREV_OFF = 80_i64;
@Target("arch:x86_64 && !os:windows")
comptime i64 VX_PREV_OFF = 64_i64;
@Target("arch:x86")
comptime i64 VX_PREV_OFF = 24_i64;

@Target("arch:x86_64 && os:windows")
comptime i64 VX_TYPE_OFF = 88_i64;
@Target("arch:x86_64 && !os:windows")
comptime i64 VX_TYPE_OFF = 72_i64;
@Target("arch:x86")
comptime i64 VX_TYPE_OFF = 28_i64;

// Estado global: [0]=puntero al frame top, [VX_PTR]=valor de la excepcion,
// [2*VX_PTR]=type-id de la excepcion activa (encoding por intervalos para el
// type matching del catch; ver lower_try).  24 bytes cubre 3 slots en 64-bit
// (8+8+8) y de sobra en 32-bit (4+4+4).
@section(".vxexc", "rw")
bytes vx_exc_state { times 24 db 0 }

// ===========================================================================
// setjmp/longjmp -- variante SysV x86-64 (ELF Linux/BSD).
// rdi = buf.  En la entrada (Naked): [rsp]=retaddr, [rsp+8]=rsp del caller.
// ===========================================================================
@Target("arch:x86_64 && !os:windows")
@Naked
public i64 __vx_setjmp(i64 buf) {
	asm volatile {
		mov     [rdi], rbx
		mov     [rdi+8], rbp
		mov     [rdi+16], r12
		mov     [rdi+24], r13
		mov     [rdi+32], r14
		mov     [rdi+40], r15
		lea     rax, [rsp+8]
		mov     [rdi+48], rax
		mov     rax, [rsp]
		mov     [rdi+56], rax
		xor     eax, eax
		ret
	}
}

@Target("arch:x86_64 && !os:windows")
@Naked
public void __vx_longjmp(i64 buf, i64 val) {
	asm volatile {
		    mov     rbx, [rdi]
		    mov     rbp, [rdi+8]
		    mov     r12, [rdi+16]
		    mov     r13, [rdi+24]
		    mov     r14, [rdi+32]
		    mov     r15, [rdi+40]
		    mov     rsp, [rdi+48]
		    mov     rax, rsi
		    test    rax, rax
		    jnz     .nz
		    inc     rax
		.nz:
		    jmp     [rdi+56]
	}
}

// ===========================================================================
// setjmp/longjmp -- variante Win64 x86-64 (PE Windows).
// rcx = buf.  Callee-saved Win64: rbx,rbp,rdi,rsi,r12-r15 (8) + rsp + rip.
// (xmm6-15 callee-saved se salvan en v2 si hace falta float cross-jump.)
// ===========================================================================
@Target("arch:x86_64 && os:windows")
@Naked
public i64 __vx_setjmp(i64 buf) {
	asm volatile {
		mov     [rcx], rbx
		mov     [rcx+8], rbp
		mov     [rcx+16], rdi
		mov     [rcx+24], rsi
		mov     [rcx+32], r12
		mov     [rcx+40], r13
		mov     [rcx+48], r14
		mov     [rcx+56], r15
		lea     rax, [rsp+8]
		mov     [rcx+64], rax
		mov     rax, [rsp]
		mov     [rcx+72], rax
		xor     eax, eax
		ret
	}
}

@Target("arch:x86_64 && os:windows")
@Naked
public void __vx_longjmp(i64 buf, i64 val) {
	asm volatile {
		    mov     rbx, [rcx]
		    mov     rbp, [rcx+8]
		    mov     rdi, [rcx+16]
		    mov     rsi, [rcx+24]
		    mov     r12, [rcx+32]
		    mov     r13, [rcx+40]
		    mov     r14, [rcx+48]
		    mov     r15, [rcx+56]
		    mov     rsp, [rcx+64]
		    mov     rax, rdx
		    test    rax, rax
		    jnz     .nz
		    inc     rax
		.nz:
		    jmp     [rcx+72]
	}
}

// ===========================================================================
// setjmp/longjmp -- variante x86-32 cdecl (ELF/PE 32 bits).
// Args en pila: setjmp [esp+4]=buf;  longjmp [esp+4]=buf, [esp+8]=val.
// Callee-saved cdecl: ebx,esi,edi,ebp (4) + esp + eip.
// ===========================================================================
@Target("arch:x86")
@Naked
public i64 __vx_setjmp(i64 buf) {
	asm volatile {
		mov     eax, [esp+4]
		mov     [eax], ebx
		mov     [eax+4], esi
		mov     [eax+8], edi
		mov     [eax+12], ebp
		lea     ecx, [esp+4]
		mov     [eax+16], ecx
		mov     ecx, [esp]
		mov     [eax+20], ecx
		xor     eax, eax
		ret
	}
}

@Target("arch:x86")
@Naked
public void __vx_longjmp(i64 buf, i64 val) {
	asm volatile {
		    mov     eax, [esp+4]
		    mov     edx, [esp+8]
		    mov     ecx, [eax+20]
		    mov     ebx, [eax]
		    mov     esi, [eax+4]
		    mov     edi, [eax+8]
		    mov     ebp, [eax+12]
		    mov     esp, [eax+16]
		    mov     eax, edx
		    test    eax, eax
		    jnz     .nz
		    inc     eax
		.nz:
		    jmp     ecx
	}
}

// ===========================================================================
// Gestion de la pila de frames -- VX puro, identico en todos los targets
// (los offsets son comptime const parametricos por @Target).
// ===========================================================================

// push: frame.prev = top; frame.type = type; top = frame.
public void __vx_push_frame(i64 frame, i64 type) {
	i64 base = (i64) section_start(".vxexc");
	i64 top  = *((i64*)(base));
	*((i64*)(frame + VX_PREV_OFF)) = top;
	*((i64*)(frame + VX_TYPE_OFF)) = type;
	*((i64*)(base))                = frame;
}

// pop: top = top.prev (si hay).
public void __vx_pop_frame() {
	i64 base = (i64) section_start(".vxexc");
	i64 top  = *((i64*)(base));
	if (top != 0) {
		*((i64*)(base)) = *((i64*)(top + VX_PREV_OFF));
	}
}

// Nadie recogio la excepcion.
//
// Es un GANCHO, y este cuerpo es solo lo que se puede hacer SIN SISTEMA: parar
// la maquina, que es lo que hace el panico de un nucleo.  Este fichero no
// importa nada a proposito -- un objeto freestanding que use try/catch no debe
// arrastrar `WriteFile` ni `ExitProcess` solo por tenerlo --.
//
// Cuando hay sistema, quien SABE escribir completa esto: el driver antepone
// aqui una llamada a `__uncaught_report` (en `vx_io.vx`), que vuelca lo que
// el programa llevara impreso, dice lo que paso por la salida de error y sale
// con 134 -- el mismo codigo que el interprete y el JIT --.  Esa llamada no
// vuelve, asi que lo de abajo solo corre en un binario sin I/O.
//
// Y se puede SUSTITUIR: si el modulo del usuario define su propio
// `__uncaught`, gana el suyo al fusionar y el driver no le anade nada.
//
// Antes esto era `while (true) { }` en todos los casos.  Un programa hospedado
// que lanzaba y no capturaba se quedaba colgado PARA SIEMPRE y sin decir nada:
// peor que terminar mal, porque ni siquiera termina.
@Target("arch:x86_64 || arch:x86")
public void __uncaught() {
	// `hlt` en bucle: la forma clasica de detener un nucleo.  El bucle esta
	// porque una interrupcion despierta al procesador de un `hlt` suelto.
	while (true) {
		asm volatile { hlt };
	}
}

@Target("!arch:x86_64 && !arch:x86")
public void __uncaught() {
	while (true) { }
}

// throw: guarda el valor + type-id y hace longjmp al frame top.  El handler
// (lower_try) despacha por tipo: si ningun catch matchea, re-llama a __vx_throw
// con el mismo (value, type) tras popear su frame -> longjmp al frame externo
// (propagacion).  Sin frame, la lanzo alguien y no la recogio nadie.
public void __vx_throw(i64 value, i64 type_id) {
	i64 base = (i64) section_start(".vxexc");
	*((i64*)(base + VX_PTR))     = value;
	*((i64*)(base + 2 * VX_PTR)) = type_id;
	i64 top = *((i64*)(base));
	if (top != 0) {
		__vx_longjmp(top, 1);
	}
	__uncaught();
}

// el valor de la excepcion activa (para el landingpad del catch).
public i64 __vx_get_value() {
	i64 base = (i64) section_start(".vxexc");
	return *((i64*)(base + VX_PTR));
}

// el type-id (intervalo lo) de la excepcion activa (para el dispatch del catch).
public i64 __vx_get_type() {
	i64 base = (i64) section_start(".vxexc");
	return *((i64*)(base + 2 * VX_PTR));
}
