/**
 * @file chan.vx
 * @brief Canales (estilo CSP) sobre el scheduler M:N de fibras (pool).  Una
 *        fibra que hace recv de un canal sin dato (o send de uno lleno) se
 *        BLOQUEA -- sale de la run-queue -- y la operacion opuesta la despierta
 *        EXACTAMENTE a ella, entregandole el valor DIRECTAMENTE.  SIN busy-wait,
 *        SIN libc mas alla de malloc, SIN GC.  Buffered (cap >= 1) y rendezvous
 *        (cap 0) con el MISMO codigo.  Soporta cierre, recepcion/envio sin
 *        suspension y seleccion (`select`) sobre la recepcion en N canales.
 *
 * @par Handle tipado
 * El canal se maneja como un overlay @c Chan: la vista ES el puntero al bloque
 * host, asi que un valor @c Chan se pasa/devuelve como el handle mismo y los
 * campos se acceden directamente (`ch.closed`, `&ch.lock`) sin conversiones.
 *
 * @par Modelo: WAITER (nodo de espera) + claim
 * Cada operacion que se bloquea encola un WAITER en la wait-queue del canal.  El
 * Waiter vive en la PILA de la fibra que espera (las pilas de fibra son FIJAS ->
 * estable mientras la fibra esta parkeada; su lock protege el acceso cruzado).
 * El otro lado, bajo el lock: saca un Waiter, lo RECLAMA, escribe/lee su ELEM
 * (entrega directa, sin pasar por el ring) y despierta a su fibra.
 *   - Espera NORMAL (recv/send de un solo canal): Waiter.sel = 0 -> SIEMPRE
 *     entregable (un `if sel==0` sin CAS: cero coste atomico en el camino comun).
 *   - Espera de SELECT (recv sobre N canales): un Waiter por canal comparten una
 *     PALABRA de select; el primer canal que entrega hace CAS(0->1) sobre ella
 *     (la RECLAMA) y publica el indice ganador; los demas ven la palabra ya
 *     reclamada (CAS falla) y SALTAN ese Waiter.  Asi un solo caso del select
 *     gana, aunque varios canales esten listos a la vez.
 *
 * @par Correccion del wakeup (hand-off del lock a traves del park)
 * El lock del canal (o TODOS los del select, en orden de direccion para no
 * deadlockear) se mantiene desde el chequeo + registro hasta DESPUES de que la
 * fibra hizo el context-switch: `vx_park` recibe una accion diferida que suelta
 * el lock (o todos).  La fibra ya esta fuera de CPU y encolada cuando el otro
 * lado puede tomar el lock -> nunca se pierde un wakeup ni una condicion de
 * carrera "wake antes de park".
 *
 * @par Rendimiento
 * UN spinlock por canal: protege ring + ambas wait-queues; el `wake` se emite
 * fuera del lock.  Capacidad potencia de dos -> indexado `& mask` (sin division).
 * El select mantiene los N locks solo durante el registro; una operacion sobre un
 * unico canal solo evalua una comparacion (`sel == 0`) para el soporte de select.
 *
 * @par Uso
 * Entre FIBRAS (tareas del pool).  main coordina con pool_join (no es fibra:
 * no puede bloquearse en un canal ni en un select).
 */

namespace std.chan;

import std.atomic only vx_spin_lock, vx_spin_unlock, atomic_cas64;
import std.pool only fiber, vx_park, vx_wake, vx_cur_fiber;

// ---------------------------------------------------------------------------
// Vista tipada (overlay) de la cabecera del canal sobre el bloque host: el valor
// @c Chan ES el puntero al bloque, asi que pasarlo/devolverlo pasa el handle y
// `ch.campo` / `&ch.campo` acceden directo, sin conversiones.  El ring buffer va
// inline a partir de CH_HDR (tamano dinamico = cap*8), fuera del overlay.
// ---------------------------------------------------------------------------
// `rwq_h/rwq_t/swq_h/swq_t` guardan un Waiter (y `SelCase.chan` un Chan), pero
// van como direccion `i64`: HOY un campo de tipo overlay NO guarda un handle --
// es una VISTA EMBEBIDA en ese offset, y asignarle un handle COPIA su payload en
// el campo.  Verificado leyendo desde una funcion OPACA (no es una lectura stale):
//
//     @overlay struct Inner  { i64 v  @0x00; }
//     @overlay struct Holder { Inner ch @0x08; i64 tag @0x00; }
//     void put(Holder h, Inner i) { h.ch = i; }
//     i64  addr(Holder h) { Inner i = h.ch; return (i64) i; }
//     // tras put(h, a):  addr(h) == (i64)h + 8   -> vista sobre el propio campo
//     //                  addr(h) != (i64)a       -> NO guarda el handle
//     //                  *(i64*)(h+8) == a.v     -> copio el CONTENIDO
//
// Un test que solo compare VALORES no distingue las dos semanticas (leer `h.ch.v`
// da lo mismo con ambas).  TODO: tipar estos campos cuando el campo de tipo
// overlay guarde el handle.
@overlay
public struct Chan {
	i64  lock   @0x00; // spinlock (0=libre, 1=tomado).  Tambien marca la BASE.
	i64  cap    @0x08; // capacidad del ring (0=rendezvous; si >=1, pot. de 2).
	i64  mask   @0x10; // cap - 1 (indexado del ring; 0 si cap 0).
	i64  head   @0x18; // indice de lectura (monotono, enmascarado).
	i64  tail   @0x20; // indice de escritura.
	i64  count  @0x28; // items en el buffer.
	i64  rwq_h  @0x30; // recv wait-queue: cabeza (Waiter).
	i64  rwq_t  @0x38; // recv wait-queue: cola.
	i64  swq_h  @0x40; // send wait-queue: cabeza.
	i64  swq_t  @0x48; // send wait-queue: cola.
	bool closed @0x50; // true si el canal esta cerrado.
}
const i64 CH_HDR = 88_i64; // el ring empieza aqui: cap*8 bytes inline.

/// Direccion base del bloque host del canal (el handle ES el puntero).  Uso
/// interno: aritmetica del ring y orden de lock del select.
i64 __vxch_base(Chan c) {
	return (i64) c;
}

// ---------------------------------------------------------------------------
// WAITER: nodo de espera.  Vive en la PILA de la fibra que se bloquea (pilas de
// fibra FIJAS -> estable mientras esta parkeada; el lock del canal serializa el
// acceso cruzado).  Enlazados por `next` en la wait-queue del canal.
// ---------------------------------------------------------------------------
// El Waiter se REGISTRA en la cola como direccion (`i64 w = (i64)&wbuf[0]`) y se
// envuelve con `Waiter(w)` en el punto de uso; los `__vxch_wq_*` reciben la
// direccion del SLOT (cabeza/cola) y hacen el load/store crudo sobre el -- ahi el
// cast en la frontera es legitimo.  NOTA: threading estos handles por
// parametros/returns en los helpers de cola provoco cuelgues intermitentes
// (wakeups perdidos) en los select parkeados; la causa no esta aislada, asi que se
// mantiene el idioma "direccion + Waiter(x) en el uso", que es estable.
//
// TODO: `next` guarda un Waiter -> tiparlo cuando el campo de tipo overlay guarde
// el handle (ver la nota en @c Chan).  `sel`/`win` guardan la direccion de un
// local de la fibra que espera (`&local` = puntero VM): no admiten `i64*` (host) y
// un Optional no cabe en un layout fijo (16 B, tag+valor) -> quedan como direccion
// cruda + helper con nombre (__vxch_is_select_waiter), sin comparar `== 0` a pelo.
@overlay
struct Waiter {
	i64   next @0x00; // Waiter siguiente en la cola.
	fiber fib  @0x08; // fibra que espera.
	i64   elem @0x10; // valor: recv lo LEE del sender; send lo pone; sender lo LEE.
	i64   sel  @0x18; // 0 = espera NORMAL (siempre entregable, sin CAS).  !=0 =
	// direccion de la PALABRA de select compartida (CAS 0->1).
	i64 win @0x20; // si es de select: direccion del slot donde publicar el indice.
	i64 idx @0x28; // indice del caso de select (se escribe en *win al ganar).
}
const i64 WAITER_QW    = 6_i64;  // qwords por Waiter (48 bytes).
const i64 VXCH_SEL_MAX = 32_i64; // maximo de canales por select (cota de pila).

/// @return true si el Waiter espera por un SELECT (comparte una palabra de
///         reclamacion con los Waiter hermanos); false si es una espera NORMAL.
bool __vxch_is_select_waiter(Waiter w) {
	return w.sel != 0;
}

/// Despierta a la fibra @p f si hay alguna.  Encapsula en UN solo sitio el
/// "no hay nadie a quien despertar" de los helpers bajo-el-lock (el out-param no
/// puede ser `Optional<fiber>`: hoy un Optional por puntero no round-trippea).
void __vxch_wake_if_any(fiber f) {
	if (f != 0) {
		vx_wake(f);
	}
}

/// Accion diferida de park (un canal): el WORKER la ejecuta tras el switch ->
/// suelta el lock del canal cuando la fibra ya esta fuera de CPU (hand-off).
void __vxch_unlock_after_park(i64 lock_addr, i64 fib) {
	vx_spin_unlock((i64*)lock_addr);
}

/// Accion diferida de park (SELECT): suelta TODOS los locks unicos que el select
/// tomo (selctx = {n_uniq, &uniq[0]}), post-switch.  El orden de unlock es libre.
void __vxch_sel_unlock_all(i64 selctx_addr, i64 fib) {
	i64* sc   = (i64*)selctx_addr;
	i64  nu   = sc[0];
	i64  base = sc[1];
	for (i64 i = 0_i64; i < nu; i++) {
		Chan c = Chan(*(i64*)(base + i * 8));
		vx_spin_unlock(&c.lock);
	}
}

// ---------------------------------------------------------------------------
// Wait-queue de Waiter (bajo el lock del canal; sin atomicos: el lock basta).
// ---------------------------------------------------------------------------
void __vxch_wq_push(i64 head_addr, i64 tail_addr, i64 w) {
	Waiter(w).next = 0;
	i64 tl = *(i64*)tail_addr;
	if (tl == 0) {
		*(i64*)head_addr = w;
	} else {
		Waiter(tl).next = w;
	}
	*(i64*)tail_addr = w;
}
/// Saca el primer Waiter de la cola.
/// @return Some(Waiter) si habia alguno; None si la cola esta vacia.
Optional<Waiter> __vxch_wq_pop(i64 head_addr, i64 tail_addr) {
	i64 hd = *(i64*)head_addr;
	if (hd == 0) {
		return None();
	}
	i64    nx        = Waiter(hd).next;
	*(i64*)head_addr = nx;
	if (nx == 0) {
		*(i64*)tail_addr = 0;
	}
	return Some(Waiter(hd));
}
/// Desenlaza un Waiter CONCRETO de la cola (limpieza de los perdedores del
/// select).  @return true si estaba y se quito, false si no (ya lo saco un waker).
bool __vxch_wq_remove(i64 head_addr, i64 tail_addr, i64 target) {
	i64 prev = 0_i64;
	i64 cur  = *(i64*)head_addr;
	while (cur != 0) {
		i64 nx = Waiter(cur).next;
		if (cur == target) {
			if (prev == 0) {
				*(i64*)head_addr = nx;
			} else {
				Waiter(prev).next = nx;
			}
			if (nx == 0) {
				*(i64*)tail_addr = prev;
			}
			return true;
		}
		prev = cur;
		cur  = nx;
	}
	return false;
}

/// Reclama un Waiter para entrega.  Espera NORMAL (sel==0): siempre true, sin
/// CAS.  Espera de SELECT: CAS(palabra, 0->1); si gana publica el indice y da
/// true; si otro canal ya la reclamo, da false (el waker SALTA este Waiter).
bool __vxch_claim(Waiter w) {
	if (!__vxch_is_select_waiter(w)) {
		return true;
	}
	if (atomic_cas64((i64*)w.sel, 0, 1) == 0) {
		*(i64*)(w.win) = w.idx; // publica el indice ganador
		return true;
	}
	return false;
}

/**
 * @brief Crea un canal de capacidad @p cap.  cap<=0 -> rendezvous (sin buffer).
 *        cap>=1 -> buffered, REDONDEADA a la siguiente potencia de dos (ring
 *        indexado con `& mask`, sin division).
 * @return el handle @c Chan; su bloque es nulo si no hubo memoria (el llamante
 *         puede comprobarlo con chan_is_null antes de usarlo).
 */
public Chan chan_new(i64 cap) {
	i64 c    = 0_i64;
	i64 mask = 0_i64;
	if (cap >= 1) {
		c = 1;
		while (c < cap) {
			c = c * 2;
		}
		mask = c - 1;
	}
	Chan ch = Chan((i64) malloc(CH_HDR + c * 8));
	if (!chan_is_null(ch)) {
		ch.lock   = 0;
		ch.cap    = c;
		ch.mask   = mask;
		ch.head   = 0;
		ch.tail   = 0;
		ch.count  = 0;
		ch.rwq_h  = 0;
		ch.rwq_t  = 0;
		ch.swq_h  = 0;
		ch.swq_t  = 0;
		ch.closed = false;
	}
	return ch;
}

/// @return true si el handle no apunta a ningun bloque (OOM en chan_new).
public bool chan_is_null(Chan ch) {
	return __vxch_base(ch) == 0;
}

/// Libera el canal (nadie debe estar bloqueado en el).
public void chan_free(Chan ch) {
	if (!chan_is_null(ch)) {
		free((u8*) __vxch_base(ch));
	}
}

/// Direccion del slot i-esimo del ring (host).
i64 __vxch_slot(Chan c, i64 idx, i64 mask) {
	return __vxch_base(c) + CH_HDR + (idx & mask) * 8;
}

// ---------------------------------------------------------------------------
// Nucleo bajo-el-lock: intentar recibir / enviar sin bloquear.  Comparten estas
// dos rutinas send/recv, try_*, y el pass-1 del select (evita duplicar logica y
// garantiza semantica IDENTICA en todos los caminos).  El lock del canal debe
// estar TOMADO al entrar y sigue tomado al salir.  *pwake = fibra a despertar
// DESPUES de soltar el lock (0 si ninguna).  El caller despierta fuera del lock.
// ---------------------------------------------------------------------------

/// Intenta RECIBIR de `c` (lock tomado).  NO trata el canal cerrado (el caller
/// lo maneja: recv devuelve 0, try_recv da false, select lo trata como listo).
/// @return true si hubo valor (en *pval), false si no habia nada disponible.
bool __vxch_recv_locked(Chan c, i64* pval, fiber* pwake) {
	*pwake = (fiber) 0;
	// (1) Dato en el buffer (moviendo un emisor en espera al hueco liberado).
	if (c.count > 0) {
		i64* rs  = (i64*)__vxch_slot(c, c.head, c.mask);
		i64  val = *rs;
		c.head = c.head + 1;
		// Mueve un emisor en espera al hueco liberado (saltando los Waiter de un
		// select que otro canal ya reclamo).
		while (true) {
			match __vxch_wq_pop((i64)&c.swq_h, (i64)&c.swq_t) {
				case None    => { break; } // no hay emisores en espera
				case Some(s) => {
					if (__vxch_claim(s)) {
						i64* ws = (i64*)__vxch_slot(c, c.tail, c.mask);
						*    ws = s.elem;    // valor del emisor -> hueco liberado
						c.tail = c.tail + 1; // count: -1 (lei) +1 (meti) = igual
						*pwake = s.fib;
						*pval  = val;
						return true;
					}
				}
			}
		}
		c.count = c.count - 1;
		*pval = val;
		return true;
	}
	// (2) Buffer vacio + emisor en espera (rendezvous cap 0) -> entrega directa.
	while (true) {
		match __vxch_wq_pop((i64)&c.swq_h, (i64)&c.swq_t) {
			case None    => { break; }
			case Some(s) => {
				if (__vxch_claim(s)) {
					*pval  = s.elem;
					*pwake = s.fib;
					return true;
				}
			}
		}
	}
	return false;
}

/// Intenta ENVIAR `v` a `c` (lock tomado).  NO trata el canal cerrado (el caller
/// lo maneja).  @return true si se entrego a un receptor o se encolo en el
/// buffer; false si enviar bloquearia (sin receptor ni hueco).
bool __vxch_send_locked(Chan c, i64 v, fiber* pwake) {
	*pwake = (fiber) 0;
	// (1) Receptor(es) en espera -> entrega directa (saltando select ya ganados).
	while (true) {
		match __vxch_wq_pop((i64)&c.rwq_h, (i64)&c.rwq_t) {
			case None    => { break; } // no hay receptores en espera
			case Some(r) => {
				if (__vxch_claim(r)) {
					r.elem = v;
					*pwake = r.fib;
					return true;
				}
			}
		}
	}
	// (2) Hueco en el buffer.
	if (c.count < c.cap) {
		i64* slot = (i64*)__vxch_slot(c, c.tail, c.mask);
		*    slot = v;
		c.tail  = c.tail + 1;
		c.count = c.count + 1;
		return true;
	}
	return false;
}

/**
 * @brief Envia @p v por el canal.  Prioridad: (1) receptor en espera -> entrega
 *        directa; (2) hueco en el buffer -> encolar; (3) bloquear en la sendq.
 */
public void chan_send(Chan ch, i64 v) {
	vx_spin_lock(&ch.lock);
	// Enviar por un canal CERRADO descarta el valor y vuelve (no bloquea ni
	// corrompe el buffer): el productor debe dejar de enviar tras cerrar.
	if (ch.closed) {
		vx_spin_unlock(&ch.lock);
		return;
	}
	fiber wake = 0;
	if (__vxch_send_locked(ch, v, &wake)) {
		vx_spin_unlock(&ch.lock);
		__vxch_wake_if_any(wake); // wake FUERA del lock
		return;
	}
	// (3) Lleno (o rendezvous sin receptor) -> me encolo en la sendq y bloqueo.
	// Solo una FIBRA puede suspenderse; main (None) no puede bloquearse en un
	// canal (coordina con pool_join) -> suelta el lock y vuelve sin bloquear.
	match vx_cur_fiber() {
		case None => {
			vx_spin_unlock(&ch.lock);
		}
		case Some(self) => {
			// El Waiter vive en mi pila (estable mientras la fibra esta parkeada).
			i64[6] wbuf;
			i64    w = (i64)&wbuf[0];
			Waiter(w).fib  = self;
			Waiter(w).elem = v;
			Waiter(w).sel  = 0;
			Waiter(w).next = 0;
			__vxch_wq_push((i64)&ch.swq_h, (i64)&ch.swq_t, w);
			vx_park((i64)(cfn(i64, i64) -> void) __vxch_unlock_after_park,
				(i64)&ch.lock);
		// Reanudada: un receptor tomo mi elem directamente.  Nada que hacer.
		}
	}
}

/**
 * @brief Recibe un valor.  Prioridad: (1) dato en el buffer (moviendo un emisor
 *        en espera al hueco liberado); (2) emisor en espera (rendezvous) ->
 *        entrega directa; (3) bloquear en la recvq.  recv de un canal cerrado y
 *        drenado devuelve 0 SIN bloquear (semantica CSP).
 * @return el valor recibido.
 */
public i64 chan_recv(Chan ch) {
	vx_spin_lock(&ch.lock);
	i64   val  = 0_i64;
	fiber wake = 0;
	if (__vxch_recv_locked(ch, &val, &wake)) {
		vx_spin_unlock(&ch.lock);
		__vxch_wake_if_any(wake);
		return val;
	}
	// Cerrado y drenado -> devolver 0 sin bloquear.  El consumidor distingue
	// "cerrado" via chan_is_closed en su condicion de bucle.
	if (ch.closed) {
		vx_spin_unlock(&ch.lock);
		return 0;
	}
	// (3) Nada -> me encolo (Waiter en mi pila) y bloqueo; el sender pondra mi elem.
	// Solo una FIBRA puede suspenderse; main (None) no puede bloquearse -> 0.
	match vx_cur_fiber() {
		case None => {
			vx_spin_unlock(&ch.lock);
			return 0;
		}
		case Some(self) => {
			i64[6] wbuf;
			i64    w = (i64)&wbuf[0];
			Waiter(w).fib  = self;
			Waiter(w).elem = 0;
			Waiter(w).sel  = 0;
			Waiter(w).next = 0;
			__vxch_wq_push((i64)&ch.rwq_h, (i64)&ch.rwq_t, w);
			vx_park((i64)(cfn(i64, i64) -> void) __vxch_unlock_after_park,
				(i64)&ch.lock);
			return Waiter(w).elem;
		}
	}
	return 0; // inalcanzable (match exhaustivo); satisface el retorno de la fn
}

/**
 * @brief Cierra el canal.  Marca cerrado y DESPIERTA a todos los que esperan:
 *        los receptores en la recvq reciben 0 (o disparan su select); los
 *        emisores bloqueados se despiertan (su envio se pierde).  Idempotente.
 *        Tras close, recv de un canal vacio devuelve 0 al instante (no bloquea).
 */
public void chan_close(Chan ch) {
	vx_spin_lock(&ch.lock);
	ch.closed = true;
	// Receptores en espera -> reciben 0 (o disparan su select con su indice).  El
	// wake solo encola en el scheduler (no re-toma este lock) -> seguro aqui.
	while (true) {
		match __vxch_wq_pop((i64)&ch.rwq_h, (i64)&ch.rwq_t) {
			case None    => { break; }
			case Some(r) => {
				if (__vxch_claim(r)) {
					r.elem = 0;
					vx_wake(r.fib);
				}
			}
		}
	}
	// Emisores bloqueados (su valor se descarta).
	while (true) {
		match __vxch_wq_pop((i64)&ch.swq_h, (i64)&ch.swq_t) {
			case None    => { break; }
			case Some(s) => {
				if (__vxch_claim(s)) {
					vx_wake(s.fib);
				}
			}
		}
	}
	vx_spin_unlock(&ch.lock);
}

/// @return true si el canal esta cerrado.
public bool chan_is_closed(Chan ch) {
	return ch.closed;
}

/**
 * @brief Envio NO-BLOQUEANTE.  Igual que send pero sin el paso (3): si no hay
 *        receptor esperando NI hueco en el buffer, NO bloquea -> devuelve false.
 * @return true si el valor se entrego/encolo; false si enviaria bloquearia (o
 *         el canal esta cerrado).
 */
public bool chan_try_send(Chan ch, i64 v) {
	vx_spin_lock(&ch.lock);
	if (ch.closed) {
		vx_spin_unlock(&ch.lock);
		return false;
	}
	fiber wake = 0;
	if (__vxch_send_locked(ch, v, &wake)) {
		vx_spin_unlock(&ch.lock);
		__vxch_wake_if_any(wake);
		return true;
	}
	vx_spin_unlock(&ch.lock);
	return false;
}

/**
 * @brief Recepcion NO-BLOQUEANTE.  Igual que recv pero sin el paso (3): si no
 *        hay dato en el buffer NI emisor esperando, NO bloquea -> devuelve false
 *        y no toca @p out (un canal cerrado+vacio tambien da false; el caller
 *        consulta chan_is_closed).
 * @param out puntero donde escribir el valor recibido (solo si retorna true).
 * @return true si se recibio un valor (escrito en @p out); false si no habia nada.
 */
public bool chan_try_recv(Chan ch, i64* out) {
	vx_spin_lock(&ch.lock);
	i64   val  = 0_i64;
	fiber wake = 0;
	if (__vxch_recv_locked(ch, &val, &wake)) {
		vx_spin_unlock(&ch.lock);
		__vxch_wake_if_any(wake);
		*out = val;
		return true;
	}
	vx_spin_unlock(&ch.lock);
	return false;
}

// ---------------------------------------------------------------------------
// SELECT: multiplexado sobre varias RECEPCIONES (fan-in).  Primitivo CSP para
// esperar en N canales a la vez.  Un canal esta "listo" si tiene un valor
// disponible (buffer/rendezvous) O esta CERRADO (recv de cerrado no espera;
// entrega 0 -> el caller distingue con chan_is_closed sobre el indice ganador).
// ---------------------------------------------------------------------------

/// Rotacion POR-HILO del arranque del barrido -> reparto JUSTO (no favorecer
/// siempre al canal 0; evita starvation de los ultimos indices).
thread_local i64 __vxch_sel_rot = 0_i64;

/**
 * @brief Sondea una vez la recepcion en @p n canales y entrega el valor del
 *        primero disponible, sin suspender la fibra (equivale a un `select` con
 *        clausula `default`).
 * @details Recorre los canales arrancando en un indice rotatorio por-hilo (para
 *          repartir la preferencia y no favorecer siempre al canal 0).  Un canal
 *          "dispara" si tiene un valor listo (escrito en @p out) o esta cerrado
 *          (entrega 0 en @p out).  Si ninguno dispara, no toca @p out.
 * @param chans array de @p n handles de canal.
 * @param n     numero de canales.
 * @param out   destino del valor recibido (valido solo si retorna >= 0).
 * @return indice [0,n) del canal que entrego, o -1 si ninguno tenia nada.
 */
public i64 chan_select_recv(Chan* chans, i64 n, i64* out) {
	if (n <= 0) {
		return -1;
	}
	i64 start = __vxch_sel_rot;
	__vxch_sel_rot = start + 1;
	for (i64 k = 0_i64; k < n; k++) {
		i64  i  = (start + k) % n; // barrido rotado -> justo
		Chan ch = chans[i];
		if (chan_try_recv(ch, out)) {
			return i; // valor disponible -> gana este
		}
		if (chan_is_closed(ch)) {
			*out = 0; // cerrado -> listo con 0 (Go: ok=false)
			return i;
		}
	}
	return -1; // ninguno listo (el caller hace su default)
}

/**
 * @brief Espera de forma multiplexada la recepcion en @p n canales, suspendiendo
 *        la fibra hasta que uno entregue un valor (o se cierre), y devuelve ese
 *        caso junto con el valor.  Pensada para fibras del pool; invocada desde
 *        el hilo principal degrada a sondeo repetido (no puede suspenderse).
 * @details Suspension coordinada, sin espera activa:
 *   1. Toma el lock de todos los canales implicados, en orden de direccion y sin
 *      repetir, de modo que el chequeo y el registro sean consistentes y no haya
 *      interbloqueo entre selecciones concurrentes.
 *   2. Si algun canal ya tiene un valor listo (o esta cerrado), lo entrega y
 *      libera los locks sin suspenderse.
 *   3. En otro caso encola un nodo de espera propio en la cola de recepcion de
 *      cada canal (todos comparten una palabra de reclamacion) y suspende la
 *      fibra; los locks se sueltan tras el cambio de contexto, garantizando que
 *      ningun canal pueda entregar antes de que la fibra este suspendida.
 *   4. El primer canal que entrega reclama la palabra compartida con un CAS y
 *      publica su indice; los demas ven la palabra ya reclamada y omiten el nodo.
 *      Al reanudarse, la fibra retira sus nodos de los canales restantes y
 *      devuelve el valor y el indice del canal ganador.
 * @param chans array de @p n handles de canal.  Se atiende a lo sumo VXCH_SEL_MAX
 *              canales; los handles repetidos se registran una sola vez por canal.
 * @param n     numero de canales.
 * @param out   destino del valor recibido.
 * @return indice [0,n) del canal que entrego.
 */
public i64 chan_select_recv_block(Chan* chans, i64 n, i64* out) {
	if (n <= 0) {
		return -1;
	}
	// Solo una FIBRA puede parkear; sin fibra (main) degrada a poll no-bloqueante.
	match vx_cur_fiber() {
		case None => {
			while (true) {
				i64 idx = chan_select_recv(chans, n, out);
				if (idx >= 0) {
					return idx;
				}
			}
		}
		case Some(self) => {
			return __vxch_sel_recv_parked(self, chans, n, out);
		}
	}
	return -1; // inalcanzable (match exhaustivo)
}

/// Cuerpo parkeado del select de recepcion, ya resuelta la fibra actual @p self.
i64 __vxch_sel_recv_parked(fiber self, Chan* chans, i64 n, i64* out) {
	if (n > VXCH_SEL_MAX) {
		n = VXCH_SEL_MAX; // cota de pila (VXCH_SEL_MAX Waiter + orden de lock)
	}

	i64      sel_word =  0_i64; // 0 = esperando, 1 = ya reclamado (claim CAS)
	i64      win_slot = -1_i64; // indice del caso ganador (lo escribe el claimer)
	i64[192] wbufs;             // VXCH_SEL_MAX (32) Waiter * WAITER_QW (6) qwords
	i64[32]  uniq;              // canales UNICOS ordenados (orden de lock estable)
	i64[2]   selctx;            // {n_uniq, &uniq[0]} para el parkfn (unlock all)

	// Orden de lock estable por DIRECCION + dedup -> sin deadlock ni doble-lock.
	i64 nu = 0_i64;
	for (i64 i = 0_i64; i < n; i++) {
		i64 a = __vxch_base(chans[i]);
		i64 j = nu;
		while (j > 0 && uniq[j - 1] > a) {
			j = j - 1;
		}
		i64 dup = 0_i64;
		if (j < nu && uniq[j] == a) {
			dup = 1; // ya presente en esa posicion
		}
		if (dup == 0) {
			for (i64 k = nu; k > j; k--) {
				uniq[k] = uniq[k - 1];
			}
			uniq[j] = a;
			nu      = nu + 1;
		}
	}

	// Tomar TODOS los locks unicos (en orden) -> pass-1 + registro son atomicos
	// respecto a los otros lados (nada entra/sale de las colas entremedias).
	for (i64 i = 0_i64; i < nu; i++) {
		Chan c = Chan(uniq[i]);
		vx_spin_lock(&c.lock);
	}

	// Pass-1: alguno listo YA (bajo todos los locks)?  Barrido rotado (justo).
	i64 rot = __vxch_sel_rot;
	__vxch_sel_rot = rot + 1;
	i64   found = -1_i64;
	i64   fval  =  0_i64;
	fiber fwake =  0;
	for (i64 kk = 0_i64; kk < n; kk++) {
		i64   i   = (rot + kk) % n;
		Chan  c   = chans[i];
		i64   val = 0_i64;
		fiber wk  = 0;
		if (__vxch_recv_locked(c, &val, &wk)) {
			found = i;
			fval  = val;
			fwake = wk;
			break;
		}
		if (c.closed) {
			found = i; // cerrado -> listo con 0
			fval  = 0;
			fwake = 0;
			break;
		}
	}
	if (found >= 0) {
		for (i64 i = 0_i64; i < nu; i++) {
			Chan c = Chan(uniq[i]);
			vx_spin_unlock(&c.lock);
		}
		__vxch_wake_if_any(fwake);
		*out = fval;
		return found;
	}

	// Nada listo: registrar un Waiter por canal (bajo los locks) + parkear.  Los
	// Waiter comparten sel_word/win_slot; cada uno lleva su indice `idx`.
	for (i64 i = 0_i64; i < n; i++) {
		i64 w = (i64)&wbufs[i * WAITER_QW];
		Waiter(w).fib  = self;
		Waiter(w).elem = 0;
		Waiter(w).sel  = (i64)&sel_word;
		Waiter(w).win  = (i64)&win_slot;
		Waiter(w).idx  = i;
		Waiter(w).next = 0;
		Chan c = chans[i];
		__vxch_wq_push((i64)&c.rwq_h, (i64)&c.rwq_t, w);
	}
	selctx[0] = nu;
	selctx[1] = (i64)&uniq[0];
	// El hand-off suelta todos los locks POST-switch: hasta entonces ningun canal
	// puede reclamar un Waiter -> imposible "wake antes de park".
	vx_park(
		(i64)(cfn(i64, i64) -> void) __vxch_sel_unlock_all,
		(i64)&selctx[0]
	);

	// Reanudada: el canal ganador reclamo sel_word (CAS) y publico win_slot; su
	// Waiter ya lo saco el claimer.  Limpiar los Waiter de los OTROS canales (uno
	// a uno bajo su lock; sin locks simultaneos -> sin deadlock) y devolver.
	for (i64 i = 0_i64; i < n; i++) {
		if (i != win_slot) {
			i64  w = (i64)&wbufs[i * WAITER_QW];
			Chan c = chans[i];
			vx_spin_lock(&c.lock);
			__vxch_wq_remove((i64)&c.rwq_h, (i64)&c.rwq_t, w);
			vx_spin_unlock(&c.lock);
		}
	}
	*out = Waiter((i64)&wbufs[win_slot * WAITER_QW]).elem;
	return win_slot;
}

/**
 * @brief Sondea una vez el envio en @p n canales y entrega su valor por el primero
 *        con capacidad, sin suspender la fibra (equivale a un `select` de envio con
 *        clausula `default`).
 * @details Recorre los canales desde un indice rotatorio por-hilo.  Un canal
 *          "dispara" si acepta el envio (hay un receptor esperando o hueco en el
 *          buffer) o esta cerrado (el envio se descarta, como en chan_send).
 * @param chans array de @p n handles de canal.
 * @param vals  array paralelo con el valor a enviar por cada canal.
 * @param n     numero de canales.
 * @return indice [0,n) del canal que acepto el envio, o -1 si ninguno pudo.
 */
public i64 chan_select_send(Chan* chans, i64* vals, i64 n) {
	if (n <= 0) {
		return -1;
	}
	i64 start = __vxch_sel_rot;
	__vxch_sel_rot = start + 1;
	for (i64 k = 0_i64; k < n; k++) {
		i64  i  = (start + k) % n;
		Chan ch = chans[i];
		if (chan_try_send(ch, vals[i])) {
			return i; // aceptado (receptor o buffer)
		}
		if (chan_is_closed(ch)) {
			return i; // cerrado -> el envio se descarta
		}
	}
	return -1;
}

/**
 * @brief Espera de forma multiplexada el envio en @p n canales, suspendiendo la
 *        fibra hasta que uno acepte su valor (o se cierre), y devuelve ese caso.
 *        Pensada para fibras del pool; invocada desde el hilo principal degrada a
 *        sondeo repetido (no puede suspenderse).
 * @details Es el simetrico de chan_select_recv_block sobre la cola de envio:
 *   toma el lock de todos los canales en orden de direccion (sin repetir), entrega
 *   por el primero con capacidad (o descarta si esta cerrado) sin suspenderse; si
 *   ninguno acepta, encola un nodo de espera con su valor en la cola de envio de
 *   cada canal (comparten una palabra de reclamacion) y suspende la fibra soltando
 *   los locks tras el cambio de contexto.  El primer receptor que retire uno de
 *   esos nodos lo reclama con un CAS y publica su indice; al reanudarse, la fibra
 *   retira sus nodos de los canales restantes y devuelve el canal que acepto.
 * @param chans array de @p n handles de canal.  A lo sumo VXCH_SEL_MAX; los
 *              handles repetidos se registran una sola vez por canal.
 * @param vals  array paralelo con el valor a enviar por cada canal.
 * @param n     numero de canales.
 * @return indice [0,n) del canal que acepto el envio.
 */
public i64 chan_select_send_block(Chan* chans, i64* vals, i64 n) {
	if (n <= 0) {
		return -1;
	}
	// Solo una FIBRA puede parkear; main (None) degrada a poll no-bloqueante.
	match vx_cur_fiber() {
		case None => {
			while (true) {
				i64 idx = chan_select_send(chans, vals, n);
				if (idx >= 0) {
					return idx;
				}
			}
		}
		case Some(self) => {
			return __vxch_sel_send_parked(self, chans, vals, n);
		}
	}
	return -1; // inalcanzable (match exhaustivo)
}

/// Cuerpo parkeado del select de envio, ya resuelta la fibra actual @p self.
i64 __vxch_sel_send_parked(fiber self, Chan* chans, i64* vals, i64 n) {
	if (n > VXCH_SEL_MAX) {
		n = VXCH_SEL_MAX;
	}

	i64      sel_word =  0_i64;
	i64      win_slot = -1_i64;
	i64[192] wbufs;
	i64[32]  uniq;
	i64[2]   selctx;

	// Orden de lock estable por direccion + dedup (identico al de recepcion).
	i64 nu = 0_i64;
	for (i64 i = 0_i64; i < n; i++) {
		i64 a = __vxch_base(chans[i]);
		i64 j = nu;
		while (j > 0 && uniq[j - 1] > a) {
			j = j - 1;
		}
		i64 dup = 0_i64;
		if (j < nu && uniq[j] == a) {
			dup = 1;
		}
		if (dup == 0) {
			for (i64 k = nu; k > j; k--) {
				uniq[k] = uniq[k - 1];
			}
			uniq[j] = a;
			nu      = nu + 1;
		}
	}

	for (i64 i = 0_i64; i < nu; i++) {
		Chan c = Chan(uniq[i]);
		vx_spin_lock(&c.lock);
	}

	// Pass-1: algun canal acepta el envio (o esta cerrado)?  Barrido rotado.
	i64 rot = __vxch_sel_rot;
	__vxch_sel_rot = rot + 1;
	i64   found = -1_i64;
	fiber fwake =  0;
	for (i64 kk = 0_i64; kk < n; kk++) {
		i64  i = (rot + kk) % n;
		Chan c = chans[i];
		if (c.closed) {
			found = i; // cerrado -> el envio se descarta
			fwake = 0;
			break;
		}
		fiber wk = 0;
		if (__vxch_send_locked(c, vals[i], &wk)) {
			found = i;
			fwake = wk;
			break;
		}
	}
	if (found >= 0) {
		for (i64 i = 0_i64; i < nu; i++) {
			Chan c = Chan(uniq[i]);
			vx_spin_unlock(&c.lock);
		}
		__vxch_wake_if_any(fwake);
		return found;
	}

	// Nada acepta: registrar un nodo de espera con su valor en cada cola de envio.
	for (i64 i = 0_i64; i < n; i++) {
		i64 w = (i64)&wbufs[i * WAITER_QW];
		Waiter(w).fib  = self;
		Waiter(w).elem = vals[i]; // valor a enviar por este canal
		Waiter(w).sel  = (i64)&sel_word;
		Waiter(w).win  = (i64)&win_slot;
		Waiter(w).idx  = i;
		Waiter(w).next = 0;
		Chan c = chans[i];
		__vxch_wq_push((i64)&c.swq_h, (i64)&c.swq_t, w);
	}
	selctx[0] = nu;
	selctx[1] = (i64)&uniq[0];
	vx_park(
		(i64)(cfn(i64, i64) -> void) __vxch_sel_unlock_all,
		(i64)&selctx[0]
	);

	// Reanudada: un receptor reclamo un nodo y publico win_slot.  Limpiar los
	// nodos de las colas de envio de los OTROS canales y devolver el ganador.
	for (i64 i = 0_i64; i < n; i++) {
		if (i != win_slot) {
			i64  w = (i64)&wbufs[i * WAITER_QW];
			Chan c = chans[i];
			vx_spin_lock(&c.lock);
			__vxch_wq_remove((i64)&c.swq_h, (i64)&c.swq_t, w);
			vx_spin_unlock(&c.lock);
		}
	}
	return win_slot;
}

// ---------------------------------------------------------------------------
// SELECT general: casos de RECEPCION y ENVIO combinados en una sola espera.
// Cada caso se describe con un overlay SelCase sobre un array que arma el
// llamante.  chan_select_recv/_send[_block] son atajos ergonomicos para una
// sola direccion; este es el primitivo general (multiplexa ambas).
// ---------------------------------------------------------------------------
const i64 VXCH_RECV = 0_i64; // caso de recepcion
const i64 VXCH_SEND = 1_i64; // caso de envio

// Vista tipada de un caso.  El llamante construye el array como i64 crudos segun
// este layout: por cada caso, 3 qwords consecutivos [chan, dir, val], con
// `chan` = `(i64) mi_canal`.
//
// DEUDA (no se puede cerrar hoy): a diferencia del resto del API, este primitivo
// NO toma handles tipados.  La forma natural seria `SelCase* cases` con el canal
// tipado (`Chan ch`), pero un campo de tipo OVERLAY no guarda un handle: es una
// vista EMBEBIDA y el store es un no-op silencioso (mismo motivo que las colas de
// Chan; repro completo en la nota del overlay Chan, arriba).  Verificado en las
// tres formas: campo de struct de valor, campo de overlay, y overlay
// auto-referencial.  Cuando el campo de tipo overlay guarde el handle, migrar a
// `public struct SelCase { Chan ch; i64 dir; i64 val; }` + `chan_select(SelCase*, n)`.
@overlay
struct SelCase {
	i64 chan @0x00; // canal del caso (Chan; i64 por la limitacion de arriba).
	i64 dir  @0x08; // VXCH_RECV (0) o VXCH_SEND (1).
	i64 val  @0x10; // envio: valor a enviar; recepcion: valor recibido (se escribe).
}
const i64 SELCASE_QW = 3_i64; // qwords por SelCase (24 bytes).

/**
 * @brief Sondea una vez un conjunto de casos de recepcion/envio y ejecuta el
 *        primero que este listo, sin suspender la fibra (`select` con `default`).
 * @details Recorre los casos desde un indice rotatorio por-hilo.  Un caso de
 *          recepcion dispara si su canal tiene un valor (lo escribe en el campo
 *          `val` del caso) o esta cerrado (escribe 0); uno de envio dispara si su
 *          canal acepta el valor de `val` o esta cerrado (el envio se descarta).
 * @param cases direccion de un array de casos; cada caso son 3 qwords i64
 *              consecutivos [chan, dir, val] (dir 0=recepcion, 1=envio), con
 *              `chan` = `(i64) mi_canal`.
 * @param n     numero de casos.
 * @return indice [0,n) del caso que disparo, o -1 si ninguno estaba listo.
 */
public i64 chan_select_try(i64 cases, i64 n) {
	if (n <= 0) {
		return -1;
	}
	i64 start = __vxch_sel_rot;
	__vxch_sel_rot = start + 1;
	for (i64 k = 0_i64; k < n; k++) {
		i64  i  = (start + k) % n;
		i64  cs = cases + i * SELCASE_QW * 8;
		Chan ch = Chan(SelCase(cs).chan);
		if (SelCase(cs).dir == VXCH_RECV) {
			i64 v = 0_i64;
			if (chan_try_recv(ch, &v)) {
				SelCase(cs).val = v;
				return i;
			}
			if (chan_is_closed(ch)) {
				SelCase(cs).val = 0;
				return i;
			}
		} else {
			if (chan_try_send(ch, SelCase(cs).val)) {
				return i;
			}
			if (chan_is_closed(ch)) {
				return i; // envio a cerrado: se descarta
			}
		}
	}
	return -1;
}

/**
 * @brief Espera de forma multiplexada un conjunto de casos de recepcion y envio,
 *        suspendiendo la fibra hasta que uno pueda completarse, y ejecuta ese
 *        caso.  Pensada para fibras del pool; invocada desde el hilo principal
 *        degrada a sondeo repetido (no puede suspenderse).
 * @details Generaliza chan_select_recv_block y chan_select_send_block:
 *   toma el lock de todos los canales implicados en orden de direccion (sin
 *   repetir), completa el primer caso listo sin suspenderse; si ninguno lo esta,
 *   encola un nodo de espera en la cola de recepcion (casos de recepcion) o de
 *   envio (casos de envio) de cada canal -- todos comparten una palabra de
 *   reclamacion -- y suspende la fibra soltando los locks tras el cambio de
 *   contexto.  El primer canal que complete uno de esos nodos lo reclama con un
 *   CAS y publica su indice; al reanudarse, la fibra retira los nodos restantes.
 *   Para el caso ganador de recepcion, el valor recibido queda en su campo `val`.
 * @param cases direccion de un array de casos; cada caso son 3 qwords i64
 *              consecutivos [chan, dir, val] (dir 0=recepcion, 1=envio), con
 *              `chan` = `(i64) mi_canal`.  A lo sumo VXCH_SEL_MAX casos.
 * @param n     numero de casos.
 * @return indice [0,n) del caso ejecutado.
 */
public i64 chan_select(i64 cases, i64 n) {
	if (n <= 0) {
		return -1;
	}
	// Solo una FIBRA puede parkear; main (None) degrada a poll no-bloqueante.
	match vx_cur_fiber() {
		case None => {
			while (true) {
				i64 idx = chan_select_try(cases, n);
				if (idx >= 0) {
					return idx;
				}
			}
		}
		case Some(self) => {
			return __vxch_select_parked(self, cases, n);
		}
	}
	return -1; // inalcanzable (match exhaustivo)
}

/// Cuerpo parkeado del select mixto, ya resuelta la fibra actual @p self.
i64 __vxch_select_parked(fiber self, i64 cases, i64 n) {
	if (n > VXCH_SEL_MAX) {
		n = VXCH_SEL_MAX;
	}

	i64      sel_word =  0_i64;
	i64      win_slot = -1_i64;
	i64[192] wbufs;
	i64[32]  uniq;
	i64[2]   selctx;

	// Orden de lock estable por direccion del canal + dedup.
	i64 nu = 0_i64;
	for (i64 i = 0_i64; i < n; i++) {
		i64 a = SelCase(cases + i * SELCASE_QW * 8).chan;
		i64 j = nu;
		while (j > 0 && uniq[j - 1] > a) {
			j = j - 1;
		}
		i64 dup = 0_i64;
		if (j < nu && uniq[j] == a) {
			dup = 1;
		}
		if (dup == 0) {
			for (i64 k = nu; k > j; k--) {
				uniq[k] = uniq[k - 1];
			}
			uniq[j] = a;
			nu      = nu + 1;
		}
	}

	for (i64 i = 0_i64; i < nu; i++) {
		Chan c = Chan(uniq[i]);
		vx_spin_lock(&c.lock);
	}

	// Pass-1: algun caso listo YA (bajo todos los locks)?  Barrido rotado.
	i64 rot = __vxch_sel_rot;
	__vxch_sel_rot = rot + 1;
	i64   found = -1_i64;
	i64   fval  =  0_i64;
	fiber fwake =  0;
	for (i64 kk = 0_i64; kk < n; kk++) {
		i64  i  = (rot + kk) % n;
		i64  cs = cases + i * SELCASE_QW * 8;
		Chan c  = Chan(SelCase(cs).chan);
		if (SelCase(cs).dir == VXCH_RECV) {
			i64   val = 0_i64;
			fiber wk  = 0;
			if (__vxch_recv_locked(c, &val, &wk)) {
				found = i;
				fval  = val;
				fwake = wk;
				break;
			}
			if (c.closed) {
				found = i;
				fval  = 0;
				fwake = 0;
				break;
			}
		} else {
			if (c.closed) {
				found = i; // envio a cerrado: descarta
				fval  = 0;
				fwake = 0;
				break;
			}
			fiber wk = 0;
			if (__vxch_send_locked(c, SelCase(cs).val, &wk)) {
				found = i;
				fval  = 0;
				fwake = wk;
				break;
			}
		}
	}
	if (found >= 0) {
		for (i64 i = 0_i64; i < nu; i++) {
			Chan c = Chan(uniq[i]);
			vx_spin_unlock(&c.lock);
		}
		__vxch_wake_if_any(fwake);
		i64 cs = cases + found * SELCASE_QW * 8;
		if (SelCase(cs).dir == VXCH_RECV) {
			SelCase(cs).val = fval; // publica el valor recibido en el caso
		}
		return found;
	}

	// Nada listo: registrar un nodo de espera por caso en la cola que corresponda
	// a su direccion (recepcion -> rwq, envio -> swq); todos comparten sel_word.
	for (i64 i = 0_i64; i < n; i++) {
		i64 cs = cases + i * SELCASE_QW * 8;
		i64 w  = (i64)&wbufs[i * WAITER_QW];
		Waiter(w).fib  = self;
		Waiter(w).sel  = (i64)&sel_word;
		Waiter(w).win  = (i64)&win_slot;
		Waiter(w).idx  = i;
		Waiter(w).next = 0;
		Chan c = Chan(SelCase(cs).chan);
		if (SelCase(cs).dir == VXCH_RECV) {
			Waiter(w).elem = 0;
			__vxch_wq_push((i64)&c.rwq_h, (i64)&c.rwq_t, w);
		} else {
			Waiter(w).elem = SelCase(cs).val;
			__vxch_wq_push((i64)&c.swq_h, (i64)&c.swq_t, w);
		}
	}
	selctx[0] = nu;
	selctx[1] = (i64)&uniq[0];
	vx_park(
		(i64)(cfn(i64, i64) -> void) __vxch_sel_unlock_all,
		(i64)&selctx[0]
	);

	// Reanudada: retirar los nodos de los casos NO ganadores de su cola (segun
	// direccion) y, si el ganador es de recepcion, publicar el valor recibido.
	for (i64 i = 0_i64; i < n; i++) {
		if (i != win_slot) {
			i64  cs = cases + i * SELCASE_QW * 8;
			i64  w  = (i64)&wbufs[i * WAITER_QW];
			Chan c  = Chan(SelCase(cs).chan);
			vx_spin_lock(&c.lock);
			if (SelCase(cs).dir == VXCH_RECV) {
				__vxch_wq_remove((i64)&c.rwq_h, (i64)&c.rwq_t, w);
			} else {
				__vxch_wq_remove((i64)&c.swq_h, (i64)&c.swq_t, w);
			}
			vx_spin_unlock(&c.lock);
		}
	}
	i64 cs = cases + win_slot * SELCASE_QW * 8;
	if (SelCase(cs).dir == VXCH_RECV) {
		SelCase(cs).val = Waiter((i64)&wbufs[win_slot * WAITER_QW]).elem;
	}
	return win_slot;
}
