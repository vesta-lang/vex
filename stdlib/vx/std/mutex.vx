/**
 * @file mutex.vx
 * @brief Mutex (exclusion mutua) cooperativo para fibras del scheduler M:N
 *        (pool).  Una fibra que no puede adquirir el mutex se SUSPENDE (sale
 *        de la run-queue) en lugar de girar en espera activa; el que libera pasa
 *        la propiedad directamente a la siguiente fibra en cola y la despierta.
 *        SIN busy-wait entre fibras, SIN libc mas alla de malloc, SIN GC.
 *
 * @par Handle tipado
 * El mutex se maneja como un overlay @c Mutex: la vista ES el puntero al bloque
 * host, asi que un valor @c Mutex se pasa/devuelve como el handle mismo y los
 * campos se acceden directamente (`m.held`, `&m.spin`) sin conversiones.
 *
 * @par Modelo (fast-path por CAS; el spinlock solo protege la cola)
 * El estado "tomado" (@c held) es una palabra atomica.  Sin contencion, adquirir
 * es UNA sola operacion atomica (`CAS(held, 0 -> 1)`) sin tocar el spinlock
 * interno.  Solo la ruta CONTENDIDA (encolar la fibra + suspenderla) y el
 * `unlock` toman el spinlock, que protege la cola de espera y las transiciones
 * de estado bajo contienda.  La cola guarda las FIBRAS bloqueadas usando la
 * wait-queue fiber-nodo de pool (vx_wq_push/pop): una fibra bloqueada en el
 * mutex esta en UNA sola cola, asi que basta su enlace propio (a diferencia del
 * select, que registra un nodo por canal).  Al liberar con fibras en espera se
 * hace un HAND-OFF directo: la propiedad pasa a la primera en cola sin marcar el
 * mutex libre (evita que otra fibra lo robe entremedias; justicia FIFO sin
 * inanicion).
 *
 * @par Correccion del wakeup
 * El spinlock interno se mantiene desde el encolado hasta DESPUES de que la fibra
 * hizo el cambio de contexto: vx_park recibe una accion diferida que lo suelta
 * post-switch.  El que libera no puede tomar el spinlock (ni sacar la fibra de la
 * cola) hasta que esta ya esta suspendida -> nunca se pierde un wakeup.
 *
 * @par Cuando NO usar un mutex (hay herramientas mas optimas)
 * Para un contador o flag compartido, una operacion ATOMICA (atomic) es mas
 * eficiente (sin suspension ni cola).  Para transferir propiedad o coordinar
 * etapas, un CANAL (chan) es lo idiomatico.  El mutex es para SECCIONES
 * CRITICAS COMPUESTAS: un invariante de varios pasos sobre una estructura
 * compartida que ninguna atomica cubre por si sola.
 *
 * @par Semantica
 * NO reentrante: una fibra que ya posee el mutex y vuelve a hacer lock se
 * bloqueara a si misma.  El hilo principal (no es fibra, no puede suspenderse)
 * adquiere por espera activa cooperativa.
 */

namespace std.mutex;

import std.types only uintptr;
import std.atomic only vx_spin_lock, vx_spin_unlock, atomic_cas64,
atomic_store64, vx_cpu_relax;
import std.pool only fiber, vx_park, vx_wake, vx_cur_fiber, vx_wq_push, vx_wq_pop;

// ---------------------------------------------------------------------------
// Vista tipada del mutex sobre su bloque host.  @c held se accede SIEMPRE con
// operaciones atomicas (fast-path sin spinlock); la cola (wq_*) y @c owner viven
// bajo el spinlock interno.
// ---------------------------------------------------------------------------
@overlay
public struct Mutex {
	i64 held @0x00; // 0 = mutex libre, 1 = mutex tomado (palabra atomica).
	i64 spin @0x08; // spinlock que protege la cola (solo bajo contienda).
	i64 wq_h @0x10; // cola de fibras en espera: cabeza (fiber-nodo).
	i64 wq_t @0x18; // cola de fibras en espera: cola.
}
const i64 MUTEX_SZ = 32_i64;

/// Accion diferida de park: el worker la ejecuta tras el cambio de contexto ->
/// suelta el spinlock interno cuando la fibra ya esta fuera de CPU (hand-off).
void __vxm_unlock_after_park(i64 spin_addr, i64 fib) {
	vx_spin_unlock((i64*)spin_addr);
}

/**
 * @brief Reserva un mutex en el heap host y lo inicializa libre.
 * @return el handle @c Mutex; su bloque es nulo si no hubo memoria (el llamante
 *         puede comprobarlo con mutex_is_null antes de usarlo).
 */
public Mutex mutex_new() {
	Mutex m = Mutex((i64) malloc(MUTEX_SZ));
	if (!mutex_is_null(m)) {
		m.held = 0;
		m.spin = 0;
		m.wq_h = 0;
		m.wq_t = 0;
	}
	return m;
}

/// @return true si el handle no apunta a ningun bloque (OOM en mutex_new).
public bool mutex_is_null(Mutex m) {
	return (i64)&m.held == 0;
}

/// Libera el mutex (nadie debe poseerlo ni estar en espera).
public void mutex_free(Mutex m) {
	if (!mutex_is_null(m)) {
		free((u8*)&m.held); // &m.held = base del bloque (held @0x00)
	}
}

/**
 * @brief Adquiere el mutex.  Si esta libre lo toma y vuelve; si esta tomado,
 *        encola la fibra actual y la suspende hasta que otra libere y le pase la
 *        propiedad.  El hilo principal (no es fibra) adquiere por espera activa.
 */
public void mutex_lock(Mutex m) {
	// Fast-path SIN contencion: una sola atomica.
	if (atomic_cas64(&m.held, 0, 1) == 0) {
		return;
	}
	// Contendido: solo una FIBRA puede suspenderse; el hilo principal gira.
	match vx_cur_fiber() {
		case None => {
			while (atomic_cas64(&m.held, 0, 1) != 0) {
				vx_cpu_relax();
			}
		}
		case Some(self) => {
			// Bajo el spinlock (que protege la cola), RE-intenta el CAS por si se
			// libero entre el fast-path y la toma del spinlock; si sigue tomado,
			// encola la fibra y la suspende (hand-off del spinlock post-switch).
			vx_spin_lock(&m.spin);
			if (atomic_cas64(&m.held, 0, 1) == 0) {
				vx_spin_unlock(&m.spin);
			} else {
				vx_wq_push((uintptr) & m.wq_h, (uintptr) & m.wq_t, self);
				vx_park((i64)(cfn(i64, i64) -> void) __vxm_unlock_after_park,
					(i64)&m.spin);
			// Reanudada: el que libero nos paso la propiedad (held sigue 1).
			}
		}
	}
}

/**
 * @brief Intento de adquisicion sin suspender (pura atomica, sin spinlock).
 * @return true si se tomo el mutex, false si ya estaba tomado.
 */
public bool mutex_trylock(Mutex m) {
	return atomic_cas64(&m.held, 0, 1) == 0;
}

/**
 * @brief Libera el mutex.  Si hay fibras en espera, pasa la propiedad a la
 *        primera en cola (hand-off directo, sin marcar el mutex libre) y la
 *        despierta; si no, marca el mutex libre.
 */
public void mutex_unlock(Mutex m) {
	vx_spin_lock(&m.spin);
	fiber w = vx_wq_pop((uintptr) & m.wq_h, (uintptr) & m.wq_t);
	if (w != 0) {
		// Hand-off: la siguiente fibra pasa a ser duena; `held` sigue 1 (nadie mas
		// puede tomarlo entremedias).  El wake va fuera del spinlock.
		vx_spin_unlock(&m.spin);
		vx_wake(w);
		return;
	}
	// Sin esperas: liberar.
	atomic_store64(&m.held, 0);
	vx_spin_unlock(&m.spin);
}
