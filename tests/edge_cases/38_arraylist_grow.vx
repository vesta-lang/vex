// Edge: ArrayList con muchos push para forzar grow.
i32 main() {
	ArrayList xs = arraylist(2);
	i32       i  = 0_i32;
	while (i < 100) {
		xs.push(i);
		i = i + 1;
	}
	// Validar size + acceso al index 0 y 99.
	i32 first = xs.get(0);
	i32 last  = xs.get(99);
	if (first == 0 && last == 99 && xs.size() == 100) return 42;
	return 1;
}
