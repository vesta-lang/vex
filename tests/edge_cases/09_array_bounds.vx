// Edge: array bounds.   no garantiza bounds check; arr[i] con i out of range
// es UB, pero NO debe crashear silenciosamente con basura random.
i32 main() {
	i32[10] arr;
	i32     i = 0_i32;
	while (i < 10) {
		arr[i] = i * 10;
		i      = i + 1;
	}
	// Verificar boundary OK.
	if (arr[0] == 0 && arr[9] == 90) return 42;
	return 1;
}
