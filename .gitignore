# archivos ocultos y de configuración
.*

# ...pero sí trackear la config de formato del proyecto
!.clang-format
# ...y el CI de GitHub Actions
!.github/
!.github/**

# archivos de memoria temporales
memoria_*


# carpetas de configuración de IDEs y entornos virtuales
.idea
.xmake
.vscode
.venv

# CMake build directories
cmake-build-debug
cmake-build-release
cmake-build-*
cmake-*
build*/
build-windows
build-linux

# certificados y claves privadas
*.pem

# librerias compiladas y archivos de configuración de OpenSSL
libs/Windows/OpenSSL-Win64/bin
libs/Windows/OpenSSL-Win64/exp
libssl*
libcrypto*

_pdf
read_bytecode.hexpat

diagramas

# Carpeta de documentación generada por Doxygen
./doc/doxygen_doc
doxygen_doc

# est ees un code de prueba de 6 millones de instrucciones
code_carga_pruebas.vel

# Archivos de bytecode compilados
*.velb
*.velb-map
*.pdb
*.exe
*.o
*.elf
*.gch
*.obj
*.dll
*.vprof

# historiales de ejecución de comandos
*history.txt

generated_vel_files

# Archivos temp de agentes de AI
claude*
chatgpt*
copilot*
deepseck*
# Politica: NUNCA se commitea ningun .sh (solo scripts Python en el repo).
# Cubre runners e2e, benches y cualquier script auxiliar de shell.
*.sh

# temporales
*.vexi
*.vexir
*.vxi
*.vxir
# Lo que el ASA supo del modulo, guardado para la siguiente compilacion.  Es
# cache como los dos de arriba: se regenera y no describe el programa, lo
# describe el fuente.
*.vxfacts

doc/exhaustive_tests*
__pycache__
bench_plots/per_bench/*

tem
temp
tmp
